        sv_cells = {}
        for j = 0, GRID - 1 do
            for i = 0, GRID - 1 do
                local s = i / (GRID - 1)
                local v = 1 - (j / (GRID - 1))
                table.insert(sv_cells, {
                    s = s, v = v,
                    obj = utility.create("Square", {
                        Parent = window, Filled = true, Thickness = 0,
                        Color = Color3.fromHSV(hue, s, v),
                        Size = UDim2.new(0, math.ceil(CELL) + 1, 0, math.ceil(CELL) + 1),
                        Position = UDim2.new(0, SV_X + math.floor(i * CELL), 0, SV_Y + math.floor(j * CELL)),
                        ZIndex = 23,
                    })
                })
            end
        end
        refresh_sv = function(h)
            for _, c in next, sv_cells do c.obj.Color = Color3.fromHSV(h, c.s, c.v) end
        end

        sv_cur = utility.create("Square", {
            Parent = window, Filled = false, Thickness = 1, Color = Color3.fromRGB(255, 255, 255),
            Size = UDim2.new(0, 4, 0, 4), ZIndex = 24,
        })

        hue_strips = {}
        for i = 0, HUE_ROWS - 1 do
            table.insert(hue_strips, utility.create("Square", {
                Parent = window, Filled = true, Thickness = 0,
                Color = Color3.fromHSV(i / HUE_ROWS, 1, 1),
                Size = UDim2.new(0, HUE_W, 0, math.ceil(SV_SZ / HUE_ROWS) + 1),
                Position = UDim2.new(0, HUE_X, 0, SV_Y + math.floor(i * (SV_SZ / HUE_ROWS))),
