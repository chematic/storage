local function pruneThemed()
	local i = 1
	while i <= #themed do
		if not themed[i].inst or not themed[i].inst.Parent then table.remove(themed, i)
		else i = i + 1 end
	end
end
local function applyThemeAll()
	local i = 1
	while i <= #themed do
		local e = themed[i]
		if not e.inst or not e.inst.Parent then table.remove(themed, i)
		else
			pcall(function()
				if e.isGradient then
					local a = e.fixedA and e.key.a or Library.Config[e.key.a]
					local b = Library.Config[e.key.b]
					e.inst.Color = ColorSequence.new(a, b)
				else e.inst[e.prop] = Library.Config[e.key] end
			end)
			i = i + 1
		end
	end
end

local b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64enc(s)
	local out = {}
	for i = 1, #s, 3 do
		local a = s:byte(i) or 0
		local b = s:byte(i + 1) or 0
		local c = s:byte(i + 2) or 0
		local n = a * 65536 + b * 256 + c
		local p = math.min(3, #s - i + 1)
		local c1 = math.floor(n / 262144) % 64 + 1
		local c2 = math.floor(n / 4096) % 64 + 1
		local c3 = math.floor(n / 64) % 64 + 1
		local c4 = n % 64 + 1
		out[#out + 1] = b64chars:sub(c1, c1)
		out[#out + 1] = b64chars:sub(c2, c2)
		out[#out + 1] = p >= 2 and b64chars:sub(c3, c3) or "="
		out[#out + 1] = p >= 3 and b64chars:sub(c4, c4) or "="
	end
	return table.concat(out)
end
local function b64dec(s)
	s = s:gsub("[^A-Za-z0-9+/=]", "")
	local out = {}
	for i = 1, #s, 4 do
		local c1 = b64chars:find(s:sub(i, i), 1, true)
		local c2 = b64chars:find(s:sub(i + 1, i + 1), 1, true)
		local c3 = b64chars:find(s:sub(i + 2, i + 2), 1, true)
		local c4 = b64chars:find(s:sub(i + 3, i + 3), 1, true)
		c1 = (c1 or 1) - 1; c2 = (c2 or 1) - 1; c3 = (c3 or 1) - 1; c4 = (c4 or 1) - 1
		local n = c1 * 262144 + c2 * 4096 + c3 * 64 + c4
		out[#out + 1] = string.char(math.floor(n / 65536) % 256)
		if s:sub(i + 2, i + 2) ~= "=" then out[#out + 1] = string.char(math.floor(n / 256) % 256) end
		if s:sub(i + 3, i + 3) ~= "=" then out[#out + 1] = string.char(n % 256) end
	end
	return table.concat(out)
end

local richColorMap = { red = "#FF5555", green = "#55DD55", blue = "#5599FF", orange = "#FF8844",
	yellow = "#FFCC44", accent = "#FF6B35", dim = "#A0A0A0", success = "#5CD28C", error = "#F05C48" }
local function parseRich(t)
	if not t then return "" end
	t = tostring(t)
	t = t:gsub("%*%*(.-)%*%*", "<b>%1</b>")
	t = t:gsub("{(#%x+)}", '<font color="%1">')
	t = t:gsub("{([%w_]+)}", function(c)
		return '<font color="' .. (richColorMap[c] or "#FFFFFF") .. '">'
	end)
	t = t:gsub("{/}", "</font>")
	t = t:gsub("{/color}", "</font>")
	return t
end

