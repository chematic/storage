function Library:set_defaults(d, o) d = d or {}; o = o or {}; for k, v in next, o do d[k] = v end; return d end

function Library:change_theme(t)
	if not t then return end
	Library.CurrentTheme = t
	if t.Light then Library.darken, Library.lighten = self._lighten_base, self._darken_base
	else Library.darken, Library.lighten = self._darken_base, self._lighten_base end
	local c = self:lighten(t.Tertiary, 20)
	if Library.DisplayName and Library.DisplayName.AbsoluteObject and Library.DisplayName.AbsoluteObject.Parent then
		Library.DisplayName.Text = "> user: <font color='rgb(" .. math.floor(c.R*255) .. "," .. math.floor(c.G*255) .. "," .. math.floor(c.B*255) .. ")'>" .. LocalPlayer.DisplayName .. "</font>"
	end
	for color, objects in next, Library.ThemeObjects do
		for i = #objects, 1, -1 do
			local obj = objects[i]
			local e, p, th, ca = obj[1], obj[2], obj[3], obj[4] or 0
			if not (e and e.Parent) then table.remove(objects, i)
			else
				local tc = Library.CurrentTheme[th]
				if tc then
					local mc = tc
					if ca < 0 then mc = Library:darken(tc, -1*ca) elseif ca > 0 then mc = Library:lighten(tc, ca) end
					pcall(function() e:tween{[p] = mc} end)
				end
			end
		end
	end
	if Library._hackerBg and Library._hackerBg.AbsoluteObject then
		Library._hackerBg.Visible = (t == Library.Themes.Hacker)
	end
end

function Library:object(class, props)
	local o = Instance.new(class)
	for k, v in next, {BorderSizePixel=0, AutoButtonColor=false, Font=Enum.Font.Code, Text=""} do pcall(function() o[k]=v end) end
	local m = {}; m.AbsoluteObject = o
	function m:tween(opt, cb)
		opt = Library:set_defaults({Length=0.15, Style=Enum.EasingStyle.Quad, Direction=Enum.EasingDirection.Out}, opt)
		cb = cb or function() end
		local ti = TweenInfo.new(opt.Length, opt.Style, opt.Direction)
		opt.Length=nil; opt.Style=nil; opt.Direction=nil
		local tw = TweenService:Create(o, ti, opt); tw:Play(); tw.Completed:Connect(cb); return tw
	end
	function m:round(r) r = r or 3; Library:object("UICorner", {Parent=o, CornerRadius=UDim.new(0,r)}); return m end
	function m:object(c, p) p = p or {}; p.Parent = o; return Library:object(c, p) end
	function m:crossfade(p2, l) l = l or .15; self:tween({ImageTransparency=1}); p2:tween({ImageTransparency=0}) end
	function m:fade(state, co, l, inst)
		l = l or 0.2
		if not rawget(self, "fadeFrame") then
			local f = self:object("Frame", {BackgroundColor3=co or self.BackgroundColor3, BackgroundTransparency=(state and 1) or 0, Size=UDim2.fromScale(1,1), Centered=true, ZIndex=999}):round(self.AbsoluteObject:FindFirstChildOfClass("UICorner") and self.AbsoluteObject:FindFirstChildOfClass("UICorner").CornerRadius.Offset or 0)
			rawset(self, "fadeFrame", f)
		else self.fadeFrame.BackgroundColor3 = co or self.BackgroundColor3 end
		if inst then if state then self.fadeFrame.BackgroundTransparency=0; self.fadeFrame.Visible=true
		else self.fadeFrame.BackgroundTransparency=1; self.fadeFrame.Visible=false end
		else
			if state then self.fadeFrame.BackgroundTransparency=1; self.fadeFrame.Visible=true; self.fadeFrame:tween{BackgroundTransparency=0,Length=l}
			else self.fadeFrame.BackgroundTransparency=0; self.fadeFrame:tween({BackgroundTransparency=1,Length=l},function() self.fadeFrame.Visible=false end) end
		end
	end
	function m:stroke(color, thickness, sm)
		thickness = thickness or 1; sm = sm or Enum.ApplyStrokeMode.Border
		local s = self:object("UIStroke", {ApplyStrokeMode=sm, Thickness=thickness})
		if type(color) == "table" then
			local th, ca = color[1], color[2] or 0
			local tc = Library.CurrentTheme[th]
			local mc = tc
			if ca < 0 then mc = Library:darken(tc, -1*ca) elseif ca > 0 then mc = Library:lighten(tc, ca) end
			s.Color = mc; table.insert(Library.ThemeObjects[th], {s, "Color", th, ca})
		elseif type(color) == "string" then
			s.Color = Library.CurrentTheme[color] or Color3.new(1,1,1)
			table.insert(Library.ThemeObjects[color], {s, "Color", color, 0})
		else s.Color = color end
		return m
	end
	function m:tooltip(text)
		local tc = m:object("TextLabel", {Theme={BackgroundColor3={"Main",10},TextColor3={"WeakText"}}, TextSize=12, Text=text, Position=UDim2.new(0.5,0,0,-8), TextXAlignment=Enum.TextXAlignment.Center, TextYAlignment=Enum.TextYAlignment.Center, AnchorPoint=Vector2.new(0.5,1), BackgroundTransparency=1, TextTransparency=1, ZIndex=150}):round(2)
		tc.Size = UDim2.fromOffset(tc.TextBounds.X+12, tc.TextBounds.Y+6)
		local h = false
		m.MouseEnter:connect(function() h=true; task.wait(0.15); if h and tc.AbsoluteObject.Parent then tc:tween{BackgroundTransparency=0.15,TextTransparency=0.1} end end)
		m.MouseLeave:connect(function() h=false; if tc.AbsoluteObject.Parent then tc:tween{BackgroundTransparency=1,TextTransparency=1} end end)
		return m
	end
	local ch = {
		Centered = function(v) if v then o.AnchorPoint=Vector2.new(0.5,0.5); o.Position=UDim2.fromScale(0.5,0.5) end end,
		Theme = function(v)
			for p, obj in next, v do
				if type(obj) == "table" then
					local th, ca = obj[1], obj[2] or 0
					local tc = Library.CurrentTheme[th] or Color3.new(1,1,1)
					local mc = tc
					if ca < 0 then mc = Library:darken(tc, -1*ca) elseif ca > 0 then mc = Library:lighten(tc, ca) end
					o[p] = mc; table.insert(Library.ThemeObjects[th], {m, p, th, ca})
				else
					o[p] = Library.CurrentTheme[obj] or Color3.new(1,1,1)
					table.insert(Library.ThemeObjects[obj], {m, p, obj, 0})
				end
			end
		end,
	}
	for p, v in next, props do if ch[p] then ch[p](v) else o[p] = v end end
	return setmetatable(m, {__index=function(_,k) return o[k] end, __newindex=function(_,k,v) o[k]=v end})
end

-- Standard hover/press state for interactive widgets
function Library:_hover_style(c, idle, hover, press)
	c.MouseEnter:connect(function() if not rawget(c, "_pressing") then pcall(function() c:tween{BackgroundColor3=hover} end) end end)
	c.MouseLeave:connect(function() if not rawget(c, "_pressing") then pcall(function() c:tween{BackgroundColor3=idle} end) end end)
	c.MouseButton1Down:connect(function() c._pressing = true; pcall(function() c:tween{BackgroundColor3=press} end) end)
	UserInputService.InputEnded:connect(function(k)
		if k.UserInputType == Enum.UserInputType.MouseButton1 then
			c._pressing = false
			if c.AbsoluteObject and c.AbsoluteObject.Parent then pcall(function() c:tween{BackgroundColor3=idle} end) end
		end
	end)
end

-- Terminal-styled widget container: label + desc + right slot
function Library:_widget_base(name, desc)
	local h = desc and 58 or 44
	local c = self.container:object("Frame", {Theme={BackgroundColor3="Secondary"}, Size=UDim2.new(1,-20,0,h), ZIndex=9}):round(3)
	c:stroke({"Tertiary", -30}, 1)
	c:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(12, (desc and 8) or 0), Size=UDim2.new(0.55,-12,0, desc and 16 or h), Text=name, TextSize=14, Font=Enum.Font.Code, Theme={TextColor3="StrongText"}, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=10})
	if desc then
		c:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(12, 26), Size=UDim2.new(0.55,-12,0,14), Text=desc, TextSize=11, Font=Enum.Font.Code, Theme={TextColor3="WeakText"}, TextXAlignment=Enum.TextXAlignment.Left, TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=10})
	end
	return c, h
end

function Library:show(s)
	self.Toggled = s; self.mainFrame.ClipsDescendants = true
	if s then
		self.mainFrame:tween({Size=self.mainFrame.oldSize, Length=0.22}, function()
			rawset(self.mainFrame, "oldSize", (s and self.mainFrame.oldSize) or self.mainFrame.Size)
			self.mainFrame.ClipsDescendants = false
		end)
		task.wait(0.12); self.mainFrame:fade(not s, self.mainFrame.BackgroundColor3, 0.12)
	else
		self.mainFrame:fade(not s, self.mainFrame.BackgroundColor3, 0.12); task.wait(0.08)
		self.mainFrame:tween{Size=UDim2.new(), Length=0.22}
	end
end

function Library._darken_base(_, c, f) local h,s,v = Color3.toHSV(c); f = 1-((f or 15)/80); return Color3.fromHSV(h, math.clamp(s/f,0,1), math.clamp(v*f,0,1)) end
function Library._lighten_base(_, c, f) local h,s,v = Color3.toHSV(c); f = 1-((f or 15)/80); return Color3.fromHSV(h, math.clamp(s*f,0,1), math.clamp(v/f,0,1)) end
function Library:darken(c, f) local h,s,v = Color3.toHSV(c); f = 1-((f or 15)/80); return Color3.fromHSV(h, math.clamp(s/f,0,1), math.clamp(v*f,0,1)) end
function Library:lighten(c, f) local h,s,v = Color3.toHSV(c); f = 1-((f or 15)/80); return Color3.fromHSV(h, math.clamp(s*f,0,1), math.clamp(v/f,0,1)) end
local updateSettings = function() end
function Library:set_status(txt) if self.statusText and self.statusText.AbsoluteObject.Parent then self.statusText.Text = txt end end

