local function mk_toggle(container, cfg)
    local name, risky     = cfg.name or cfg.Name or "toggle", cfg.risky or cfg.Risky or false
    local state           = cfg.state or cfg.State or false
    local flag            = cfg.flag or cfg.Flag or utility.nextflag()
    local callback        = cfg.callback or cfg.Callback or function() end
    local toggled         = false

    local holder = utility.create("Square", { Parent = container, Size = UDim2.new(1, 0, 0, 14), Filled = false, Thickness = 0, ZIndex = 8 })
    local box = utility.create("Square", { Parent = holder, Color = Color3.fromRGB(30, 30, 30), Size = UDim2.new(0, 12, 0, 12), Filled = true, Thickness = 0, ZIndex = 7 })
    local o1 = utility.outline(box, Color3.fromRGB(0, 0, 0)); utility.outline(o1, Color3.fromRGB(0, 0, 0))
    utility.create("Square", { Parent = box, Size = UDim2.new(1, -2, 1, -2), Position = UDim2.new(0, 1, 0, 1), Filled = false, Thickness = 1, Color = Color3.fromRGB(0, 0, 0), ZIndex = 8 })

    local lines = {}
    for i = 0, 3 do
        table.insert(lines, utility.create("Square", {
            Parent = box, Filled = true, Thickness = 0, Color = Color3.fromRGB(50, 50, 50),
            Size = UDim2.new(1, -4, 0, 2), Position = UDim2.new(0, 2, 0, 2 + i*2), ZIndex = 7,
        }))
    end

    utility.create("Text", {
        Parent = holder, Text = name, Size = 13,
        Color = risky and library.theme["Risky"] or library.theme["Text"],
        Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0), Font = PLEX,
        Position = UDim2.new(0, 18, 0, -2), ZIndex = 9,
    })

    local function refresh()
        for i = 0, 3 do
            local t = i / 3
            if toggled then
                lines[i+1].Color = Color3.fromRGB(
                    math.max(0, math.floor(library.theme["Accent"].R*255 - 40*t)),
                    math.max(0, math.floor(library.theme["Accent"].G*255 - 40*t)),
                    math.max(0, math.floor(library.theme["Accent"].B*255 - 40*t)))
            else
                local s = math.floor(50 - 15*t); lines[i+1].Color = Color3.fromRGB(s, s, s)
            end
        end
    end
    local function setstate() toggled = not toggled; refresh(); library.flags[flag] = toggled; callback(toggled) end
    holder.MouseButton1Click:Connect(setstate)
    local function set(b) b = type(b) == "boolean" and b or false; if toggled ~= b then setstate() end end
    set(state); flags[flag] = set; refresh()

    local api = { colorpickers = 0 }
    function api:set(b) set(b) end
    function api:new_colorpicker(c)
        local cpt = {}; api.colorpickers = api.colorpickers + 1
        local d = c.default or c.Default or Color3.fromRGB(255, 0, 0)
        local f = c.flag or c.Flag or utility.nextflag()
        local cb = c.callback or function() end
        local cp = library.createcolorpicker(d, holder, api.colorpickers - 1, f, cb, -2)
        function cpt:set(col) cp:set(col) end
        return cpt
    end
    return api
end

