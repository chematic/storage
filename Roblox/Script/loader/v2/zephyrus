	local onI = c:object("ImageLabel", {AnchorPoint=Vector2.new(1,.5), BackgroundTransparency=1, Position=UDim2.new(1,-11,0.5,0), Size=UDim2.new(0,26,0,26), Image=on, Theme={ImageColor3="Tertiary"}, ImageTransparency=(tog and 0) or 1, ZIndex=10})
	local offI = c:object("ImageLabel", {AnchorPoint=Vector2.new(1,.5), BackgroundTransparency=1, Position=UDim2.new(1,-11,0.5,0), Size=UDim2.new(0,26,0,26), Image=off, Theme={ImageColor3="WeakText"}, ImageTransparency=(tog and 1) or 0, ZIndex=10})
	c:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(10, (opts.Description and 5) or 0), Size=(opts.Description and UDim2.new(0.5,-10,0,22)) or UDim2.new(0.5,-10,1,0), Text=opts.Name, TextSize=22, Theme={TextColor3="StrongText"}, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=10})
