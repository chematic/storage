local persistPath = "EmberUI/config.json"
local presetPath = "EmberUI/presets"
local function canPersist() return writefile and readfile and isfile and isfolder and makefolder end

local function _collectSettings()
	local data = { _version = Library.ConfigVersion, _theme = Library._currentTheme }
	for id, h in pairs(Library._registry) do
		if h and h._serialize then
			local ok, v = pcall(h._serialize, h)
			if ok and v ~= nil then data[id] = v end
		end
	end
	return data
end
local function _applySettings(data)
	if type(data) ~= "table" then return false, "invalid data" end
	if data._theme and Library.Themes[data._theme] then Library:SetTheme(data._theme) end
	for id, v in pairs(data) do
		if type(id) == "string" and id:sub(1, 1) ~= "_" then
			local h = Library._registry[id]
			if h and h._deserialize then pcall(h._deserialize, h, v) end
		end
	end
	return true
end

function Library:SaveSettings()
	if not canPersist() then return false, "persistence not supported" end
	local data = _collectSettings()
	local ok, err = pcall(function()
		if not isfolder("EmberUI") then makefolder("EmberUI") end
		writefile(persistPath, HS:JSONEncode(data))
	end)
	if not ok then logError("SaveSettings", err); return false, err end
	return true
end

function Library:LoadSettings()
	if not canPersist() then return false, "persistence not supported" end
	if not isfile(persistPath) then return false, "no saved config" end
	local ok, data = pcall(function() return HS:JSONDecode(readfile(persistPath)) end)
	if not ok or type(data) ~= "table" then return false, "parse error" end
	if data._version and data._version > Library.ConfigVersion then
		return false, "config from newer version"
	end
	return _applySettings(data)
end

function Library:ResetSettings()
	for _, h in pairs(Library._registry) do
		if h and h._reset then pcall(h._reset, h) end
	end
	return true
end

function Library:ExportSettings()
	return b64enc(HS:JSONEncode(_collectSettings()))
end

function Library:ImportSettings(str)
	if type(str) ~= "string" or str == "" then return false, "invalid string" end
	local ok, json = pcall(b64dec, str)
	if not ok or not json then return false, "decode error" end
	local ok2, data = pcall(function() return HS:JSONDecode(json) end)
	if not ok2 or type(data) ~= "table" then return false, "parse error" end
	return _applySettings(data)
end

function Library:SavePreset(name)
	if not canPersist() then return false, "persistence not supported" end
	if not name or name == "" then return false, "invalid name" end
	name = name:gsub("[/\\:*?\"<>|]", "_")
	local data = _collectSettings()
	local ok, err = pcall(function()
		if not isfolder("EmberUI") then makefolder("EmberUI") end
		if not isfolder(presetPath) then makefolder(presetPath) end
		writefile(presetPath .. "/" .. name .. ".json", HS:JSONEncode(data))
	end)
	if not ok then logError("SavePreset", err); return false, err end
	return true
end

function Library:LoadPreset(name)
	if not canPersist() then return false, "persistence not supported" end
	if not name or name == "" then return false, "invalid name" end
	local path = presetPath .. "/" .. name .. ".json"
	if not isfile(path) then return false, "preset not found" end
	local ok, data = pcall(function() return HS:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false, "parse error" end
	return _applySettings(data)
end

function Library:ListPresets()
	if not canPersist() then return {} end
	local list = {}
	if not isfolder(presetPath) then return list end
	local ok, files = pcall(function() return listfiles(presetPath) end)
	if not ok or not files then return list end
	for _, f in ipairs(files) do
		if f:lower():sub(-5) == ".json" then
			local name = f:sub(1, -6)
			if #name > 0 then table.insert(list, name) end
		end
	end
	return list
end

function Library:DeletePreset(name)
	if not canPersist() then return false end
	local path = presetPath .. "/" .. name .. ".json"
	if not isfile(path) then return false end
	pcall(function() delfile(path) end)
	return true
end

function Library:EnableAutoSave(delay)
	Library._autoSave = delay or 2
end
function Library:DisableAutoSave() Library._autoSave = nil end
function Library:_triggerAutoSave()
	if not Library._autoSave then return end
	Library._autoSaveToken = Library._autoSaveToken + 1
	local tok = Library._autoSaveToken
	task.delay(Library._autoSave, function()
		if tok == Library._autoSaveToken then
			pcall(function() Library:SaveSettings() end)
		end
	end)
end

