			rc(tb, 8); sk(tb, K.ln, 1, 0.5)
			mk("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = tb })
			attachExtras(h, f); attachCtx(f, h)
			local tagFrame = mk("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = K.sf, BackgroundTransparency = 0.35, LayoutOrder = self:_nx(), Parent = self.pg })
			rc(tagFrame, 12); sk(tagFrame, K.ln, 1, 0.6)
			mk("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = tagFrame })
			mk("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, tagFrame)
			local sectionVis = not self._activeSection or self._activeSection.open
			tagFrame:SetAttribute("_sectionVisible", sectionVis)
			tagFrame:SetAttribute("_dependsVisible", true)
			if not sectionVis then tagFrame.Visible = false end
			if self._activeSection then table.insert(self._activeSection.children, tagFrame) end

			local function rebuildTags()
				for _, c in ipairs(tagFrame:GetChildren()) do
					if c:IsA("Frame") or c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
				end
				local count = 0
				for _ in pairs(h.v) do count = count + 1 end
				if count == 0 then
					mk("TextLabel", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = "No players in whitelist", TextColor3 = K.dm, Font = K.fontMed, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = tagFrame })
					return
				end
				local sorted = {}
				for name in pairs(h.v) do table.insert(sorted, name) end
				table.sort(sorted)
				for i, name in ipairs(sorted) do
					local tag = mk("Frame", { Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = K.bg, LayoutOrder = i, Parent = tagFrame })
					rc(tag, 8); sk(tag, K.ac, 1, 0.5)
					mk("TextLabel", { Size = UDim2.new(1, -46, 1, 0), Position = UDim2.new(0, 12, 0, 0), BackgroundTransparency = 1, Text = name, TextColor3 = K.tx, Font = K.fontMed, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = tag })
					local xBtn = mk("TextButton", { Size = UDim2.new(0, 24, 0, 24), Position = UDim2.new(1, -32, 0.5, -12), BackgroundColor3 = K.dg, Text = "", AutoButtonColor = false, Parent = tag })
					rc(xBtn, 6); sk(xBtn, K.dg, 1, 0.3)
					mk("ImageLabel", { Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new(0.5, -5, 0.5, -5), BackgroundTransparency = 1, Image = "rbxassetid://" .. I.close, ImageColor3 = K.tx, Parent = xBtn })
					xBtn.MouseButton1Click:Connect(function()
						if h._disabled then return end
						h.v[name] = nil
						rebuildTags()
						if cfg.OnChange then pcall(cfg.OnChange, h.v) end
						notifyChange(h, h.v, true)
					end)
				end
			end
			local function addPlayer(name)
				if name and name ~= "" and not h.v[name] then
					h.v[name] = true
					rebuildTags()
					if cfg.OnChange then pcall(cfg.OnChange, h.v) end
					notifyChange(h, h.v, true)
				end
			end
			tb.FocusLost:Connect(function(enter)
				if h._disabled then return end
				if enter and tb.Text ~= "" then
					addPlayer(tb.Text)
					tb.Text = ""
				end
			end)
			function h:get() return h.v end
			function h:add(name) addPlayer(name) end
			function h:remove(name)
				if h.v[name] then h.v[name] = nil; rebuildTags() end
			end
			function h:isWhitelisted(name) return h.v[name] == true end
			h._serialize = function()
				local arr = {}
				for k in pairs(h.v) do table.insert(arr, k) end
				return arr
			end
			h._deserialize = function(val)
				if type(val) == "table" then
					h.v = {}
					for _, name in ipairs(val) do h.v[name] = true end
					rebuildTags()
				end
			end
			h._reset = function() h.v = {}; rebuildTags() end
			local pid = opts.PersistId .. "/" .. wid
			Library._registry[pid] = h; h._id = pid
			self._handles[title] = h
			rebuildTags()
			return h
		end

