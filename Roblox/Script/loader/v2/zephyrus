	if opts.Description then c:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(10,27), Size=UDim2.new(0.5,-10,0,20), Text=opts.Description, TextSize=18, Theme={TextColor3="WeakText"}, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=10}) end
	local kd = c:object("TextLabel", {AnchorPoint=Vector2.new(1,0), Theme={BackgroundColor3={"Secondary",-20},TextColor3="WeakText"}, Position=UDim2.new(1,-20,0,16), Size=UDim2.new(0,50,0,20), TextSize=12, Text=(opts.Keybind and tostring(opts.Keybind.Name):upper()) or "?", ZIndex=10}):round(5):stroke("Tertiary")
	kd.Size = UDim2.fromOffset(kd.TextBounds.X + 20, 20)
	do
		local h, d, listen = false, false, false
		c.MouseEnter:connect(function() h=true; c:tween{BackgroundColor3=self:lighten(Library.CurrentTheme.Secondary,10)} end)
		c.MouseLeave:connect(function() h=false; if not d then c:tween{BackgroundColor3=Library.CurrentTheme.Secondary} end end)
		c.MouseButton1Down:connect(function() c:tween{BackgroundColor3=self:lighten(Library.CurrentTheme.Secondary,20)} end)
		UserInputService.InputEnded:connect(function(k) if k.UserInputType==Enum.UserInputType.MouseButton1 then c:tween{BackgroundColor3=(h and self:lighten(Library.CurrentTheme.Secondary)) or Library.CurrentTheme.Secondary} end end)
		UserInputService.InputBegan:Connect(function(k, gpe)
			if listen and not UserInputService:GetFocusedTextBox() then
				if k.UserInputType == Enum.UserInputType.Keyboard then
					if k.KeyCode ~= Enum.KeyCode.Escape then opts.Keybind = k.KeyCode end
					kd.Text = (opts.Keybind and tostring(opts.Keybind.Name):upper()) or "?"
					kd:tween{Size=UDim2.fromOffset(kd.TextBounds.X+20,20), Length=0.05}; listen = false
				end
			else if k.KeyCode == opts.Keybind then opts.Callback() end end
		end)
		c.MouseButton1Click:connect(function() if not listen then listen = true; kd.Text = "..." end end)
	end
	self:_resize_tab()
	local api = {}
	function api:Set(k) opts.Keybind = k; kd.Text = (opts.Keybind and tostring(opts.Keybind.Name):upper()) or "?"; kd:tween{Size=UDim2.fromOffset(kd.TextBounds.X+20,20), Length=0.05} end
	return api
