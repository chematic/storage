local function mk_keybind(container, cfg, key_list)
    local api = {}
    local name      = cfg.name or cfg.Name or "keybind"
    local key_name  = cfg.keybind_name or cfg.KeyBind_Name or name
    local default   = cfg.default or cfg.Default or nil
    local mode      = cfg.mode or cfg.Mode or "Hold"
    local blacklist = cfg.blacklist or cfg.Blacklist or {}
    local flag      = cfg.flag or utility.nextflag()
    local callback  = cfg.callback or function() end
    local ignore_list = cfg.ignore or cfg.Ignore or false
    local key_mode  = mode

    local holder = utility.create("Square", { Transparency = 0, ZIndex = 7, Filled = false, Thickness = 0, Size = UDim2.new(1, 0, 0, 34), Parent = container })
    utility.create("Text", { Parent = holder, Text = name, Theme = "Text", Font = PLEX, Size = 13, Position = UDim2.new(0, 0, 0, -2), ZIndex = 7, Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0) })
    local frame = utility.create("Square", { Parent = holder, Color = Color3.fromRGB(0, 0, 0), Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -18), Filled = true, Thickness = 1, ZIndex = 8 })
    local fi = utility.create("Square", { Parent = frame, Theme = "SectionBorder", Size = UDim2.new(1, -2, 1, -2), Position = UDim2.new(0, 1, 0, 1), Filled = true, Thickness = 0, ZIndex = 9 })
    utility.stripes(fi, 7, library.theme["ObjectTop"], library.theme["ObjectBottom"], 10)

    local keytext = utility.create("Text", { Parent = frame, Theme = "Text", Font = PLEX, Size = 13, Position = UDim2.new(0, 4, 0, 1), ZIndex = 11, Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0) })
    local mode_btn = utility.create("Square", { Parent = frame, Filled = true, Thickness = 1, Color = Color3.fromRGB(0, 0, 0), Size = UDim2.new(0, 46, 1, -2), Position = UDim2.new(1, -48, 0, 1), ZIndex = 10 })
    local mbi = utility.create("Square", { Parent = mode_btn, Size = UDim2.new(1, -2, 1, -2), Position = UDim2.new(0, 1, 0, 1), Color = Color3.fromRGB(40, 40, 40), Filled = true, Thickness = 0, ZIndex = 11 })
    local mode_text = utility.create("Text", { Parent = mbi, Text = key_mode, Theme = "Text", Font = PLEX, Size = 12, Center = true, Position = UDim2.new(0.5, 0, 0.5, -5), ZIndex = 12, Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0) })

    local list_obj = nil
    if not ignore_list and key_list then list_obj = key_list:add_keybind(key_name, keytext.Text) end

    local key, binding, c
    local state = false
    local function set(nk)
        if c then c:Disconnect(); if flag then library.flags[flag] = false end; callback(false); if list_obj then list_obj:is_active(false) end end
        if tostring(nk):find("Enum.KeyCode.") then nk = Enum.KeyCode[tostring(nk):gsub("Enum.KeyCode.", "")]
        elseif tostring(nk):find("Enum.UserInputType.") then nk = Enum.UserInputType[tostring(nk):gsub("Enum.UserInputType.", "")] end
        if nk ~= nil and not table.find(blacklist, nk) then
            key = nk
            local t = keymap[nk] or tostring(nk):gsub("Enum.KeyCode.", "")
            keytext.Text = t
            if list_obj then list_obj:update_text(key_name.." ["..t.."]") end
        else
            key = nil; keytext.Text = ""
            if list_obj then list_obj:update_text(key_name.." []") end
        end
    end
    set(default)

    frame.MouseButton1Click:Connect(function()
        if not binding then
            keytext.Text = "..."
            binding = utility.connect(services.InputService.InputBegan, function(i)
                set(i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode or i.UserInputType)
                utility.disconnect(binding); task.wait(); binding = nil
            end)
        end
    end)
    mode_btn.MouseButton1Click:Connect(function() key_mode = key_mode == "Hold" and "Toggle" or "Hold"; mode_text.Text = key_mode end)
    utility.connect(services.InputService.InputBegan, function(i)
        if (i.KeyCode == key or i.UserInputType == key) and not binding then
            if key_mode == "Hold" then
                if flag then library.flags[flag] = true end
                if list_obj then list_obj:is_active(true) end
                c = utility.connect(game:GetService("RunService").RenderStepped, function() if callback then callback(true) end end)
            else
                state = not state
                if flag then library.flags[flag] = state end
                if list_obj then list_obj:is_active(state) end
                callback(state)
            end
        end
    end)
    utility.connect(services.InputService.InputEnded, function(i)
        if key_mode == "Hold" and key and (i.KeyCode == key or i.UserInputType == key) then
            if c then c:Disconnect(); if list_obj then list_obj:is_active(false) end; if flag then library.flags[flag] = false end; if callback then callback(false) end end
        end
    end)
    function api:set(nk) set(nk) end
    return api
end

