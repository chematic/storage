                math.max(0, math.floor(library.theme["Accent"].G*255 - 40*t)),
                math.max(0, math.floor(library.theme["Accent"].B*255 - 40*t))),
            Size = UDim2.new(0, 0, 0, 2), Position = UDim2.new(0, 1, 0, 1 + i*2), ZIndex = 10,
        }))
    end

    local drag = utility.create("Square", { Parent = frame, Filled = true, Thickness = 0, Color = Color3.new(1,1,1), Transparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 12 })

    local function set(v)
        v = math.clamp(utility.round(v, float), min, max)
        val_text.Text = text:gsub("%[value%]", string.format("%.14g", v))
        local sx = (v - min) / (max - min)
        for i = 1, 4 do fills[i].Size = UDim2.new(sx, -2, 0, 2) end
        library.flags[flag] = v; callback(v)
    end
    set(default)

    local sliding = false
    local function slide(input) set((max-min) * ((input.Position.X - frame.AbsolutePosition.X) / frame.AbsoluteSize.X) + min) end
    utility.connect(drag.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true; slide(i) end end)
    utility.connect(drag.InputEnded, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end end)
    utility.connect(services.InputService.InputChanged, function(i) if i.UserInputType == Enum.UserInputType.MouseMovement and sliding then slide(i) end end)
    flags[flag] = set
    function api:set(v) set(v) end
    return api
end

local function mk_button(container, cfg)
    local api = {}
