						local gchars = "#@%$&*!?/\\|<>=~^_"
						local orig = Library.originalTitle
						local g = ""
						for i = 1, #orig do
							if math.random() < 0.45 then
								g = g .. gchars:sub(math.random(1, #gchars), math.random(1, #gchars))
							else
								g = g .. orig:sub(i, i)
							end
						end
						Library.title_obj.Text = g
						task.delay(math.random(5, 12)/100, function()
							if Library.title_obj and Library.originalTitle then
								Library.title_obj.Text = Library.originalTitle
							end
						end)
					end
				end
			end
		end
	end)

	-- ═══ DRAG (UNCHANGED) ═══
	do
		local S, Ev = pcall(function() return core.MouseEnter end)
		if S then
			core.Active = true
			Ev:connect(function()
				local In = core.InputBegan:connect(function(K)
					if K.UserInputType == Enum.UserInputType.MouseButton1 then
						local OP = Vector2.new(Mouse.X - core.AbsolutePosition.X, Mouse.Y - core.AbsolutePosition.Y)
						while RunService.RenderStepped:wait() and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
							if Library.LockDragging then
								local FX, FY = math.clamp(Mouse.X - OP.X, 0, gui.AbsoluteSize.X - core.AbsoluteSize.X), math.clamp(Mouse.Y - OP.Y, 0, gui.AbsoluteSize.Y - core.AbsoluteSize.Y)
								core:tween{Position=UDim2.fromOffset(FX + (core.Size.X.Offset*core.AnchorPoint.X), FY + (core.Size.Y.Offset*core.AnchorPoint.Y)), Length=Library.DragSpeed}
							else
