            utility.stripes(body, 12, library.theme["SectionTop"], library.theme["SectionBottom"], 7)

            local tw = utility.textlength(sname, PLEX, 13).X + 16
            utility.create("Square", { Parent = section, Theme = "HolderBg", Size = UDim2.new(0, tw, 0, 6), Position = UDim2.new(0, 8, 0, -6), Filled = true, Thickness = 0, ZIndex = 6 })
            utility.create("Square", { Parent = section, Theme = "Accent", Size = UDim2.new(0, 3, 0, 3), Position = UDim2.new(0, 10, 0, -4), Filled = true, Thickness = 0, ZIndex = 8 })
            utility.create("Text", { Parent = section, Text = sname, Theme = "Text", Size = 13, Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0), Font = PLEX, Position = UDim2.new(0, 16, 0, -10), ZIndex = 8 })

            local content = utility.create("Square", { Parent = section, Size = UDim2.new(1, -16, 1, -16), Position = UDim2.new(0, 8, 0, 10), Filled = false, Thickness = 0, ZIndex = 8 })
            content:AddListLayout(6)

            function stbl:new_toggle(c) return mk_toggle(content, c) end
            function stbl:new_slider(c) return mk_slider(content, c) end
            function stbl:new_button(c) return mk_button(content, c) end
            function stbl:new_dropdown(c) return mk_dropdown(content, c) end
            function stbl:new_keybind(c) return mk_keybind(content, c, key_list) end
            function stbl:new_seperator(c) mk_separator(content, c) end
            function stbl:new_colorpicker(c) return mk_colorpicker(content, c) end
            function stbl:new_textbox(c) return mk_textbox(content, c) end
            return stbl
        end

        function page_tbl:new_section_holder(scfg)
            local stbl = { buttons = {}, accents = {}, sections = {} }
            local sname = scfg.name or scfg.Name or "sections"
            local side  = (scfg.side == "left" and left) or (scfg.Side == "left" and left)
                       or (scfg.side == "right" and right) or (scfg.Side == "right" and right) or left
            local ssize = scfg.size or scfg.Size or 200

            local section = utility.create("Square", {
                Parent = side, Color = Color3.fromRGB(0, 0, 0),
                Size = ssize ~= "Fill" and UDim2.new(1, 0, 0, ssize) or UDim2.new(1, 0, 1, 0),
                Filled = true, Thickness = 1, ZIndex = 5,
            })
            local sin = utility.create("Square", { Parent = section, Theme = "SectionBorder", Size = UDim2.new(1, -2, 1, -2), Position = UDim2.new(0, 1, 0, 1), Filled = true, Thickness = 0, ZIndex = 6 })
            utility.create("Square", { Parent = sin, Theme = "Accent",     Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0, 1), Filled = true, Thickness = 0, ZIndex = 7 })
            utility.create("Square", { Parent = sin, Theme = "AccentDark", Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0, 2), Filled = true, Thickness = 0, ZIndex = 7 })
            local body = utility.create("Square", { Parent = sin, Theme = "SectionTop", Size = UDim2.new(1, 0, 1, -3), Position = UDim2.new(0, 0, 0, 2), Filled = true, Thickness = 0, ZIndex = 6 })
            utility.stripes(body, 12, library.theme["SectionTop"], library.theme["SectionBottom"], 7)

            local tw = utility.textlength(sname, PLEX, 13).X + 16
            utility.create("Square", { Parent = section, Theme = "HolderBg", Size = UDim2.new(0, tw, 0, 6), Position = UDim2.new(0, 8, 0, -6), Filled = true, Thickness = 0, ZIndex = 6 })
            utility.create("Square", { Parent = section, Theme = "Accent", Size = UDim2.new(0, 3, 0, 3), Position = UDim2.new(0, 10, 0, -4), Filled = true, Thickness = 0, ZIndex = 8 })
            utility.create("Text", { Parent = section, Text = sname, Theme = "Text", Size = 13, Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0), Font = PLEX, Position = UDim2.new(0, 16, 0, -10), ZIndex = 8 })

            local btn_row = utility.create("Square", { Size = UDim2.new(1, -16, 0, 20), Position = UDim2.new(0, 8, 0, 10), Parent = section, Filled = false, Thickness = 0, ZIndex = 6 })

            function stbl:new_section(cfg2)
                local name = cfg2.name or cfg2.Name or "tab"
                local mb = utility.create("Square", { Parent = btn_row, Color = Color3.fromRGB(30, 30, 30), Size = UDim2.new(0, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0), Filled = true, Thickness = 0, ZIndex = 7 })
                table.insert(stbl.buttons, mb)
                utility.stripes(mb, 4, library.theme["ObjectTop"], library.theme["ObjectBottom"], 8)
                utility.create("Text", { Parent = mb, Text = name, Theme = "Text", Size = 13, Center = true, Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0), Font = PLEX, Position = UDim2.new(0.5, 0, 0, 3), ZIndex = 9 })
                local mba = utility.create("Square", { Parent = mb, Visible = false, Theme = "Accent", Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2), Filled = true, Thickness = 0, ZIndex = 9 })
                table.insert(stbl.accents, mba)

                local sc = utility.create("Square", { Visible = false, Size = UDim2.new(1, -16, 1, -46), Position = UDim2.new(0, 8, 0, 36), Parent = section, Filled = false, Thickness = 0, ZIndex = 6 })
                table.insert(stbl.sections, sc)
                sc:AddListLayout(6)

                for i, v in next, stbl.buttons do
                    local n = #stbl.buttons
                    v.Size = UDim2.new(1/n, i == 1 and 0 or -1, 1, 0)
                    v.Position = UDim2.new((i-1)/n, (i-1) * 1, 0, 0)
                end

                utility.connect(mb.MouseButton1Click, function()
                    for _, v in next, stbl.buttons do if v ~= mb then utility.changeobjecttheme(v, "PageInactive") end end
                    for _, v in next, stbl.accents do if v ~= mba then v.Visible = false end end
                    for _, v in next, stbl.sections do if v ~= sc then v.Visible = false end end
                    utility.changeobjecttheme(mb, "PageActive"); mba.Visible = true; sc.Visible = true
                end)

                local m = {}
                function m:open() utility.changeobjecttheme(mb, "PageActive"); mba.Visible = true; sc.Visible = true end
                function m:new_toggle(c) return mk_toggle(sc, c) end
                function m:new_slider(c) return mk_slider(sc, c) end
                function m:new_button(c) return mk_button(sc, c) end
                function m:new_dropdown(c) return mk_dropdown(sc, c) end
                function m:new_keybind(c) return mk_keybind(sc, c, key_list) end
                function m:new_seperator(c) mk_separator(sc, c) end
                function m:new_colorpicker(c) return mk_colorpicker(sc, c) end
                function m:new_textbox(c) return mk_textbox(sc, c) end
                return m
            end
            return stbl
        end
        return page_tbl
    end
    return win
end

return library
