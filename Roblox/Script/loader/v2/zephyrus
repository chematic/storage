function library.createdropdown(holder, content, flag, callback, default, max, scrollable, scrollingmax, islist, size)
    local dropdown = utility.create("Square", {
        Filled = true, Visible = not islist, Thickness = 0, Color = Color3.fromRGB(0, 0, 0),
        Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -22), ZIndex = 7, Parent = holder,
    })
    local di = utility.create("Square", {
        Parent = dropdown, Size = UDim2.new(1, -2, 1, -2), Position = UDim2.new(0, 1, 0, 1),
        Theme = "SectionBorder", Filled = true, Thickness = 0, ZIndex = 8,
    })
    utility.stripes(di, 8, library.theme["ObjectTop"], library.theme["ObjectBottom"], 9)

    local value = utility.create("Text", {
        Parent = dropdown, Text = "", Theme = "Text", Font = PLEX, Size = 13,
        Position = UDim2.new(0, 6, 0, 4), ZIndex = 11,
        Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0),
    })
    utility.create("Text", {
        Parent = dropdown, Text = "▼", Theme = "TextDim", Font = PLEX, Size = 12,
        Position = UDim2.new(1, -20, 0, 4), ZIndex = 11,
        Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0),
    })

    local contentframe = utility.create("Square", {
        Filled = true, Visible = islist or false, Thickness = 0, Color = Color3.fromRGB(0, 0, 0),
        Size = islist and (size == "Fill" and UDim2.new(1, 0, 1, -30) or UDim2.new(1, 0, 0, size or 100)) or UDim2.new(1, 0, 0, 0),
        Position = islist and UDim2.new(0, 0, 0, 26) or UDim2.new(0, 0, 1, 6),
        ZIndex = 12, Parent = islist and holder or dropdown,
    })
    local cfi = utility.create("Square", {
        Parent = contentframe, Size = UDim2.new(1, -2, 1, -2), Position = UDim2.new(0, 1, 0, 1),
        Theme = "SectionBorder", Filled = true, Thickness = 0, ZIndex = 13,
    })
    local contentholder = utility.create("Square", {
        Transparency = 0, Size = UDim2.new(1, -6, 1, -6), Position = UDim2.new(0, 3, 0, 3),
        Parent = cfi, ZIndex = 14,
    })
    if scrollable then contentholder:MakeScrollable() end
    contentholder:AddListLayout(2)

    if not islist then
        dropdown.MouseButton1Click:Connect(function()
            contentframe.Visible = not contentframe.Visible
        end)
    end

    local optioninstances = {}
    local chosen = max and {}

    local function createoption(name)
        optioninstances[name] = {}
        local button = utility.create("Square", {
            Filled = true, Transparency = 0, Thickness = 0, Color = Color3.fromRGB(40, 40, 40),
            Size = UDim2.new(1, 0, 0, 18), ZIndex = 14, Parent = contentholder,
        })
        optioninstances[name].button = button
        optioninstances[name].text = utility.create("Text", {
            Parent = button, Text = name, Theme = "Text", Font = PLEX, Size = 13,
            Position = UDim2.new(0, 6, 0, 1), ZIndex = 15,
            Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0),
        })
        if not islist then
            contentframe.Size = UDim2.new(1, 0, 0, math.min(contentholder.AbsoluteContentSize + 6, (scrollingmax or 10) * 20 + 6))
        end
        return button, optioninstances[name].text
    end

    local function handle(option, button, text)
        button.MouseButton1Click:Connect(function()
            if max then
                if table.find(chosen, option) then
                    table.remove(chosen, table.find(chosen, option)); utility.changeobjecttheme(text, "Text")
                else
                    if #chosen >= max then
                        utility.changeobjecttheme(optioninstances[chosen[1]].text, "Text")
                        table.remove(chosen, 1)
                    end
                    table.insert(chosen, option); utility.changeobjecttheme(text, "Accent")
                end
                value.Text = #chosen == 0 and "" or table.concat(chosen, ", ")
                library.flags[flag] = chosen; callback(chosen)
            else
                for opt, tbl in next, optioninstances do
                    if opt ~= option then utility.changeobjecttheme(tbl.text, "Text") end
                end
                chosen = option; value.Text = option; utility.changeobjecttheme(text, "Accent")
                library.flags[flag] = option; callback(option)
            end
        end)
    end
    local function createall(tbl) for _, opt in next, tbl do local b, t = createoption(opt); handle(opt, b, t) end end
    createall(content)

    local function set(option)
        if max then
            option = type(option) == "table" and option or {}
            table.clear(chosen)
            for _, tbl in next, optioninstances do utility.changeobjecttheme(tbl.text, "Text") end
            for _, opt in next, option do
                if table.find(content, opt) and #chosen < max then
                    table.insert(chosen, opt); utility.changeobjecttheme(optioninstances[opt].text, "Accent")
                end
            end
            value.Text = #chosen == 0 and "" or table.concat(chosen, ", ")
            library.flags[flag] = chosen; callback(chosen)
        else
            for opt, tbl in next, optioninstances do if opt ~= option then utility.changeobjecttheme(tbl.text, "Text") end end
            if table.find(content, option) then
                chosen = option; value.Text = option
                utility.changeobjecttheme(optioninstances[option].text, "Accent")
                library.flags[flag] = chosen; callback(chosen)
            else chosen = nil; value.Text = ""; library.flags[flag] = chosen; callback(chosen) end
        end
    end
    flags[flag] = set
    set(default)

    local dt = utility.table({}, true)
    function dt:set(opt) set(opt) end
    function dt:refresh(tbl)
        content = table.clone(tbl)
        for _, opt in next, optioninstances do opt.button:Remove() end
        table.clear(optioninstances); createall(tbl); value.Text = ""
        if max then table.clear(chosen) else chosen = nil end
        library.flags[flag] = chosen; callback(chosen)
    end
    function dt:add(opt) table.insert(content, opt); local b, t = createoption(opt); handle(opt, b, t) end
    function dt:remove(opt)
        if optioninstances[opt] then
            optioninstances[opt].button:Remove(); optioninstances[opt] = nil
            if max and table.find(chosen, opt) then
                table.remove(chosen, table.find(chosen, opt))
                value.Text = #chosen == 0 and "" or table.concat(chosen, ", ")
                library.flags[flag] = chosen; callback(chosen)
            end
        end
    end
    return dt
end

