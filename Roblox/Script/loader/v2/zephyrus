function Library:notification(opts)
	opts = self:set_defaults({Title="Notification", Text="Message", Duration=3, Callback=function() end}, opts)
	local _t = tostring(opts.Title):lower()
	local notiIcon = Icons.check
	if _t:find("error") or _t:find("fail") or _t:find("denied") then notiIcon = Icons.alert
	elseif _t:find("warn") or _t:find("caution") then notiIcon = Icons.warning
	elseif _t:find("info") or _t:find("note") then notiIcon = Icons.info end

	local faded = false; local fadeOut
	local noti = self.notifs:object("Frame", {BackgroundTransparency=1, Theme={BackgroundColor3="Main"}, Size=UDim2.new(0,300,0,0), ZIndex=100}):round(10)
	noti:object("UIPadding", {PaddingBottom=UDim.new(0,11), PaddingTop=UDim.new(0,11), PaddingLeft=UDim.new(0,11), PaddingRight=UDim.new(0,11)})
	local dropShadow = noti:object("Frame", {ZIndex=0, BackgroundTransparency=1, Size=UDim2.fromScale(1,1)})
	local _shadow = dropShadow:object("ImageLabel", {Centered=true, Position=UDim2.fromScale(.5,.5), BackgroundTransparency=1, Size=UDim2.new(1,70,1,70), ZIndex=0, Image="rbxassetid://6014261993", ImageColor3=Color3.fromRGB(0,0,0), ImageTransparency=1, ScaleType=Enum.ScaleType.Slice, SliceCenter=Rect.new(49,49,450,450)})
	local durHolder = noti:object("Frame", {BackgroundTransparency=1, Theme={BackgroundColor3="Secondary"}, AnchorPoint=Vector2.new(0,1), Position=UDim2.fromScale(0,1), Size=UDim2.new(1,0,0,4), ZIndex=101}):round(100)
	local len = durHolder:object("Frame", {BackgroundTransparency=1, Theme={BackgroundColor3="Tertiary"}, Size=UDim2.fromScale(1,1), ZIndex=102}):round(100)
	local icon = noti:object("ImageLabel", {BackgroundTransparency=1, ImageTransparency=1, Position=UDim2.fromOffset(1,1), Size=UDim2.fromOffset(18,18), Image=notiIcon, Theme={ImageColor3="Tertiary"}, ZIndex=102})
	local exit = noti:object("ImageButton", {Image=Icons.x, AnchorPoint=Vector2.new(1,0), ImageColor3=Color3.fromRGB(255,255,255), Position=UDim2.new(1,-3,0,3), Size=UDim2.fromOffset(14,14), BackgroundTransparency=1, ImageTransparency=1, ZIndex=102})
	exit.MouseButton1Click:Connect(function() fadeOut() end)
	local text = noti:object("TextLabel", {BackgroundTransparency=1, Text=opts.Text, Position=UDim2.new(0,0,0,23), Size=UDim2.new(1,0,100,0), TextSize=16, TextTransparency=1, TextWrapped=true, TextColor3=Color3.fromRGB(255,255,255), TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top, ZIndex=102})
	text:tween({Size=UDim2.new(1,0,0,text.TextBounds.Y)})
	local title = noti:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(23,0), Size=UDim2.new(1,-60,0,20), Font=Enum.Font.SourceSansBold, Text=opts.Title, Theme={TextColor3="Tertiary"}, TextSize=17, TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, TextTruncate=Enum.TextTruncate.AtEnd, TextTransparency=1, ZIndex=102})

	fadeOut = function()
		if faded then return end; faded = true
		task.delay(0.3, function() pcall(function() noti.AbsoluteObject:Destroy() end); opts.Callback() end)
		icon:tween({ImageTransparency=1, Length=0.2}); exit:tween({ImageTransparency=1, Length=0.2})
		durHolder:tween({BackgroundTransparency=1, Length=0.2}); len:tween({BackgroundTransparency=1, Length=0.2})
		text:tween({TextTransparency=1, Length=0.2})
		title:tween({TextTransparency=1, Length=0.2}, function() _shadow:tween({ImageTransparency=1, Length=0.2}); noti:tween({BackgroundTransparency=1, Length=0.2, Size=UDim2.fromOffset(300,0)}) end)
	end
	_shadow:tween({ImageTransparency=.6, Length=0.2})
	noti:tween({BackgroundTransparency=0, Length=0.2, Size=UDim2.fromOffset(300, text.TextBounds.Y + 63)}, function()
		icon:tween({ImageTransparency=0, Length=0.2}); exit:tween({ImageTransparency=0, Length=0.2})
		durHolder:tween({BackgroundTransparency=0, Length=0.2}); len:tween({BackgroundTransparency=0, Length=0.2})
		text:tween({TextTransparency=0, Length=0.2}); title:tween({TextTransparency=0, Length=0.2})
	end)
	len:tween({Size=UDim2.fromScale(0,1), Length=opts.Duration}, fadeOut)
end

-- ═══ TAB ═══
function Library:tab(opts)
	opts = self:set_defaults({Name="New Tab", Icon=Icons.box}, opts)
	local tab = self.container:object("ScrollingFrame", {AnchorPoint=Vector2.new(0,1), Visible=false, BackgroundTransparency=1, Position=UDim2.fromScale(0,1), Size=UDim2.fromScale(1,1), ScrollBarThickness=0, ScrollingDirection=Enum.ScrollingDirection.Y, ZIndex=8})
	local qaBtn, qaIcon
	if not opts.Internal then
		qaBtn = self.quickAccess:object("TextButton", {Theme={BackgroundColor3="Secondary"}, ZIndex=9}):round(5):tooltip(opts.Name)
		qaIcon = qaBtn:object("ImageLabel", {BackgroundTransparency=1, Theme={ImageColor3="StrongText"}, Image=opts.Icon, Size=UDim2.fromScale(0.5,0.5), Centered=true, ZIndex=10})
	else qaBtn = opts.Internal end

	local layout = tab:object("UIListLayout", {Padding=UDim.new(0,10), HorizontalAlignment=Enum.HorizontalAlignment.Center})
	tab:object("UIPadding", {PaddingTop=UDim.new(0,10)})
	local tabBtn = Library:object("TextButton", {BackgroundTransparency=1, Parent=self.nilFolder.AbsoluteObject, Theme={BackgroundColor3="Secondary"}, Size=UDim2.new(0,125,0,25), Visible=false, ZIndex=8}):round(5)
	self.Tabs[#self.Tabs+1] = {tab, tabBtn, opts.Name}

	do
		local d, h = false, false
		tabBtn.MouseEnter:connect(function() h=true; tabBtn:tween{BackgroundTransparency=((selectedTab==tabBtn) and 0.15) or 0.3} end)
		tabBtn.MouseLeave:connect(function() h=false; tabBtn:tween{BackgroundTransparency=((selectedTab==tabBtn) and 0.15) or 1} end)
		tabBtn.MouseButton1Down:connect(function() d=true; tabBtn:tween{BackgroundTransparency=0} end)
		UserInputService.InputEnded:connect(function(k) if k.UserInputType==Enum.UserInputType.MouseButton1 then d=false; tabBtn:tween{BackgroundTransparency=((selectedTab==tabBtn) and 0.15) or (h and 0.3) or 1} end end)
		tabBtn.MouseButton1Click:Connect(function()
			for _, ti in next, self.Tabs do ti[1].Visible = false end
			selectedTab:tween{BackgroundTransparency=((selectedTab==tabBtn) and 0.15) or 1}
			selectedTab = tabBtn; tab.Visible = true; tabBtn.BackgroundTransparency = 0
			Library.UrlLabel.Text = Library.Url .. "/" .. opts.Name:lower()
		end)
		qaBtn.MouseEnter:connect(function() qaBtn:tween{BackgroundColor3=Library.CurrentTheme.Tertiary} end)
		qaBtn.MouseLeave:connect(function() qaBtn:tween{BackgroundColor3=Library.CurrentTheme.Secondary} end)
		qaBtn.MouseButton1Click:connect(function()
			if not tabBtn.Visible then
				tabBtn.Parent = self.navigation.AbsoluteObject
				tabBtn.Size = UDim2.new(0,50, tabBtn.Size.Y.Scale, tabBtn.Size.Y.Offset)
				tabBtn.Visible = true; tabBtn:fade(false, Library.CurrentTheme.Main, 0.1)
				tabBtn:tween({Size=UDim2.new(0,125, tabBtn.Size.Y.Scale, tabBtn.Size.Y.Offset), Length=0.1})
			end
			for _, ti in next, self.Tabs do ti[1].Visible = false end
			selectedTab:tween{BackgroundTransparency=((selectedTab==tabBtn) and 0.15) or 1}
			selectedTab = tabBtn; tab.Visible = true; tabBtn.BackgroundTransparency = 0
			Library.UrlLabel.Text = Library.Url .. "/" .. opts.Name:lower()
		end)
	end

	tabBtn:object("TextLabel", {Theme={TextColor3="StrongText"}, AnchorPoint=Vector2.new(0,.5), BackgroundTransparency=1, TextSize=14, Text=opts.Name, Position=UDim2.new(0,25,0.5,0), TextXAlignment=Enum.TextXAlignment.Left, Size=UDim2.new(1,-45,0.5,0), Font=Enum.Font.SourceSans, TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=9})
	tabBtn:object("ImageLabel", {AnchorPoint=Vector2.new(0,0.5), BackgroundTransparency=1, Position=UDim2.new(0,5,0.5,0), Size=UDim2.new(0,15,0,15), Image=opts.Icon, Theme={ImageColor3="StrongText"}, ZIndex=9})
	local tabBtnClose = tabBtn:object("ImageButton", {AnchorPoint=Vector2.new(1,0.5), BackgroundTransparency=1, Position=UDim2.new(1,-5,0.5,0), Size=UDim2.fromOffset(14,14), Image=Icons.x, Theme={ImageColor3="StrongText"}, ZIndex=9})

	tabBtnClose.MouseButton1Click:connect(function()
		tabBtn:fade(true, Library.CurrentTheme.Main, 0.1)
		tabBtn:tween({Size=UDim2.new(0,50,tabBtn.Size.Y.Scale,tabBtn.Size.Y.Offset), Length=0.1}, function() tabBtn.Visible=false; tab.Visible=false; tabBtn.Parent=self.nilFolder.AbsoluteObject; wait() end)
		local v = {}
		for _, t in next, self.Tabs do
			if not t[2] == selectedTab then t[1].Visible = false end
			if t[2].Visible then v[#v+1] = t end
		end
		local last = v[#v]
		if selectedTab == self.homeButton then tab.Visible = false
		elseif #v == 2 then
			selectedTab.Visible = false; tab.Visible = false; self.homePage.Visible = true
			self.homeButton:tween{BackgroundTransparency=0.15}; selectedTab = self.homeButton
			Library.UrlLabel.Text = Library.Url .. "/home"
		elseif tabBtn == last[2] then
			last = v[#v-1]; tab.Visible = false
			last[2]:tween{BackgroundTransparency=0.15}; last[1].Visible = true
			selectedTab = last[2]; Library.UrlLabel.Text = Library.Url .. "/" .. last[3]:lower()
		else
			tab.Visible = false; last[2]:tween{BackgroundTransparency=0.15}
			last[1].Visible = true; selectedTab = last[2]
			Library.UrlLabel.Text = Library.Url .. "/" .. last[3]:lower()
		end
	end)

	return setmetatable({statusText=self.statusText, container=tab, Theme=self.Theme, core=self.core, gui=self.gui, layout=layout}, Library)
end

function Library:_resize_tab()
	if self.container.ClassName == "ScrollingFrame" then
		self.container.CanvasSize = UDim2.fromOffset(0, self.layout.AbsoluteContentSize.Y + 20)
	else
		self.sectionContainer.Size = UDim2.new(1,-24,0, self.layout.AbsoluteContentSize.Y + 20)
		self.parentContainer.CanvasSize = UDim2.fromOffset(0, self.parentLayout.AbsoluteContentSize.Y + 20)
	end
end

