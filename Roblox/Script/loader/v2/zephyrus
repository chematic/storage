		table.insert(tmp, b); b:tween({TextTransparency=0, BackgroundTransparency=0})
		b.MouseButton1Click:connect(function()
			pc:tween({BackgroundTransparency=1, Length=0.1}); pt:tween({TextTransparency=1, Length=0.1}); px:tween({TextTransparency=1, Length=0.1})
			for _, bb in next, tmp do bb:tween({TextTransparency=1, BackgroundTransparency=1, Length=0.1}) end
			dk:tween({BackgroundTransparency=1, Length=0.1}, function() dk.AbsoluteObject:Destroy(); task.delay(0.25, function() Library._promptExists = false end); cb() end)
		end)
	end
end

function Library:watermark(text)
	local wm = self.gui:object("Frame", {AnchorPoint=Vector2.new(0,0), Position=UDim2.fromOffset(20,20), Size=UDim2.fromOffset(260,26), Theme={BackgroundColor3="Main"}, ZIndex=1000}):round(6):stroke("Tertiary",1)
	wm:object("Frame", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.fromOffset(0,13), Size=UDim2.fromOffset(3,20), Theme={BackgroundColor3="Tertiary"}, ZIndex=1001}):round(2)
	local t = wm:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(10,0), Size=UDim2.new(1,-10,1,0), Text=text, TextSize=14, Font=Enum.Font.SourceSansBold, Theme={TextColor3="Tertiary"}, RichText=true, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=1001})
	local api = {}
	function api:SetText(tx) t.Text = tx end
	function api:SetVisible(v) wm.Visible = v end
	function api:Remove() wm.AbsoluteObject:Destroy() end
	return api
end

function Library:config_manager(tab, opts)
	opts = self:set_defaults({Folder="AzunoConfigs", Extension=".json", Serialize=function() return {} end, Deserialize=function(t) end}, opts)
	if not isfolder(opts.Folder) then makefolder(opts.Folder) end
	local function getC() local l = {}; pcall(function() for _, f in next, listfiles(opts.Folder) do if f:sub(-#opts.Extension) == opts.Extension then table.insert(l, f:sub(#opts.Folder+2, -#opts.Extension-1)) end end end); return l end
	local cn, cs, cfg = "default", 1, getC()
	tab:divider({Text="Configuration"})
	tab:textbox({Name="Config Name", Placeholder="Enter name...", Callback=function(t) cn = t end})
	tab:dropdown({Name="Load Config", StartingText=cfg[1] or "Empty", Items=cfg, Callback=function(i) cs = i end})
	tab:button({Name="Save Current Config", Callback=function() if cn == "" then Library:notification({Title="Error", Text="Config name is empty!", Duration=3}); return end; pcall(function() local d = opts.Serialize(); writefile(opts.Folder.."/"..cn..opts.Extension, HTTPService:JSONEncode(d)); cfg = getC(); Library:notification({Title="Success", Text="Saved "..cn, Duration=3}) end) end})
	tab:button({Name="Load Config", Callback=function() local p = opts.Folder.."/"..cs..opts.Extension; if not isfile(p) then Library:notification({Title="Error", Text="Config not found!", Duration=3}); return end; pcall(function() local d = HTTPService:JSONDecode(readfile(p)); opts.Deserialize(d); Library:notification({Title="Success", Text="Loaded "..cs, Duration=3}) end) end})
	tab:button({Name="Delete Selected Config", Callback=function() local p = opts.Folder.."/"..cs..opts.Extension; if isfile(p) then delfile(p); cfg = getC(); Library:notification({Title="Success", Text="Deleted "..cs, Duration=3}) end end})
end

return setmetatable(Library, {__index=function(_, i) return rawget(Library, i:lower()) or rawget(Library, i) end})
