	local function attachExtras(h, frame)
		h._frame = frame
		h._changeFns = {}
		h._disposed = false
		Library._frameHandles[frame] = h
		function h:onChanged(fn)
			if type(fn) == "function" then table.insert(self._changeFns, fn) end
			return self
		end
		function h:tooltip(text)
			frame.MouseEnter:Connect(function() if text and text ~= "" then showTooltip(text, frame) end end)
			frame.MouseLeave:Connect(hideTooltip)
			return self
		end
		function h:setDisabled(b)
			self._disabled = b
			frame.BackgroundTransparency = b and 0.75 or 0.35
			for _, c in ipairs(frame:GetDescendants()) do
				if c:IsA("TextLabel") then c.TextTransparency = b and 0.6 or 0 end
			end
			return self
		end
		function h:setLabel(s)
			if self.label and self.label.Parent then self.label.Text = s end
			return self
		end
		function h:setDesc(s)
			if self._descLabel and self._descLabel.Parent then self._descLabel.Text = s end
			return self
		end
		function h:depends(master, predicate)
			local function upd()
				-- FIX #5: avoid `and/or` trap when predicate returns false
				local should
				if predicate then should = predicate(master)
				else should = master and master.v == true end
				frame:SetAttribute("_dependsVisible", should ~= false)
				frame.Visible = frame:GetAttribute("_sectionVisible") ~= false and frame:GetAttribute("_dependsVisible") ~= false
			end
			if master and master.onChanged then
				master:onChanged(function() upd() end)
			end
			upd()
			return self
		end
		return h
	end

