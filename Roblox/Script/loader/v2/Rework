			vl.Active = true
			local tr = mk("Frame", { Size = UDim2.new(1, -36, 0, 4), Position = UDim2.new(0, 18, 0, 38), BackgroundColor3 = K.ln, BackgroundTransparency = 0.2, Parent = f })
			rc(tr, 2)
			local fl = mk("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = K.ac, Parent = tr })
			rc(fl, 2); gr(fl, K.ac, K.ag, 0)
			local kn = mk("Frame", { Size = UDim2.new(0, 14, 0, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), Parent = tr })
			rc(kn, 9); sk(kn, K.ac, 1.5)
			local hit = mk("TextButton", { Size = UDim2.new(1, -36, 0, 24), Position = UDim2.new(0, 18, 0, 28), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = f })
			local h = { v = v, _default = v }
			attachExtras(h, f); attachCtx(f, h)
			h.label = vl
			local function ap(px, q, noCb)
				px = math.clamp(px, 0, 1)
				local val = mn + (mx - mn) * px
				if inc then val = math.floor(val / inc + 0.5) * inc end
				local prev = h.v
				h.v = val
				fl.Size = UDim2.new(px, 0, 1, 0); kn.Position = UDim2.new(px, 0, 0.5, 0)
				if q then
					local steps = 12
					local start = prev or val
					task.spawn(function()
						for i = 1, steps do
							if not vl.Parent then break end
							local interp = start + (val - start) * (i / steps)
							vl.Text = string.format("%g", interp)
							task.wait(0.02)
						end
						if vl.Parent then vl.Text = string.format("%g", val) end
					end)
				else vl.Text = string.format("%g", val) end
				if not noCb and cb then local ok, e = pcall(cb, val); if not ok then logError("Slider/" .. t, e); safeNotifyError(tostring(e)) end end
				notifyChange(h, val, q)
			end
			local dr = false
			local pendingPos = nil
