local allowedchars = {}
local shiftchars = {
    ["1"]="!",["2"]="@",["3"]="#",["4"]="$",["5"]="%",["6"]="^",["7"]="&",["8"]="*",["9"]="(",["0"]=")",
    ["-"]="_",["="]="+",["["]="{",["\\"]="|",[";"]=":",["'"]="\"",[","]="<",["."]=">",["/"]="?",["`"]="~",
}
for i = 32, 126 do table.insert(allowedchars, utf8.char(i)) end

function library.createbox(box, text, cb, finishcb)
    box.MouseButton1Click:Connect(function()
        services.ContextActionService:BindActionAtPriority(
            "disablekeyboard", function() return Enum.ContextActionResult.Sink end,
            false, 3000, Enum.UserInputType.Keyboard)
        local conn, bsconn
        local kq = 0
        if not conn then
            conn = utility.connect(services.InputService.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    if input.KeyCode ~= Enum.KeyCode.Backspace then
                        local str = services.InputService:GetStringForKeyCode(input.KeyCode)
                        if table.find(allowedchars, str) then
                            kq = kq + 1; local cq = kq
                            local shift = services.InputService:IsKeyDown(Enum.KeyCode.RightShift)
                                       or services.InputService:IsKeyDown(Enum.KeyCode.LeftShift)
                            local ch = shift and (shiftchars[str] or str:upper()) or str:lower()
                            text.Text = text.Text .. ch; cb(text.Text)
                            coroutine.wrap(function()
                                task.wait(0.5)
                                while services.InputService:IsKeyDown(input.KeyCode) and cq == kq do
                                    text.Text = text.Text .. ch; cb(text.Text); task.wait(0.02)
                                end
                            end)()
                        end
                    end
                    if input.KeyCode == Enum.KeyCode.Return then
                        services.ContextActionService:UnbindAction("disablekeyboard")
                        utility.disconnect(bsconn); utility.disconnect(conn); finishcb(text.Text)
                    end
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                    services.ContextActionService:UnbindAction("disablekeyboard")
                    utility.disconnect(bsconn); utility.disconnect(conn); finishcb(text.Text)
                end
            end)
            local bsq = 0
            bsconn = utility.connect(services.InputService.InputBegan, function(input)
                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.Backspace then
                    bsq = bsq + 1; text.Text = text.Text:sub(1, -2); cb(text.Text)
                    local cq = bsq
                    coroutine.wrap(function()
                        task.wait(0.5)
                        if bsq == cq then
                            while services.InputService:IsKeyDown(Enum.KeyCode.Backspace) do
                                text.Text = text.Text:sub(1, -2); cb(text.Text); task.wait(0.02)
                            end
                        end
                    end)()
                end
            end)
        end
    end)
end

