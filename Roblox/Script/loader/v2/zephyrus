    local holder = utility.create("Square", { Parent = container, Size = UDim2.new(1, 0, 0, 22), Filled = false, Thickness = 0, ZIndex = 6 })
    local frame = utility.create("Square", { Parent = holder, Color = Color3.fromRGB(0, 0, 0), Size = UDim2.new(1, 0, 1, 0), Filled = true, Thickness = 1, ZIndex = 7 })
    local fi = utility.create("Square", { Parent = frame, Theme = "SectionBorder", Size = UDim2.new(1, -2, 1, -2), Position = UDim2.new(0, 1, 0, 1), Filled = true, Thickness = 0, ZIndex = 8 })
    local stripes = utility.stripes(fi, 9, library.theme["ObjectTop"], library.theme["ObjectBottom"], 9)
    utility.create("Square", { Parent = fi, Filled = false, Thickness = 1, Color = Color3.fromRGB(0, 0, 0), Size = UDim2.new(1, -2, 1, -2), Position = UDim2.new(0, 1, 0, 1), ZIndex = 11 })
    local title = utility.create("Text", { Parent = fi, Text = name, Theme = "Text", Size = 13, Center = true, Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0), Font = PLEX, Position = UDim2.new(0.5, 0, 0.5, -6), ZIndex = 12 })
    local clicked, counting = false, false
    utility.connect(frame.MouseButton1Click, function()
        task.spawn(function()
            if confirm then
                if clicked then
                    clicked, counting = false, false; title.Text, title.Color = name, library.theme["Text"]; callback()
                else
                    clicked, counting = true, true
                    for i = 3, 1, -1 do if not counting then break end; title.Text, title.Color = "confirm? "..i, library.theme["Accent"]; wait(1) end
                    clicked, counting = false, false; title.Text, title.Color = name, library.theme["Text"]
                end
            else callback() end
        end)
    end)
    utility.connect(frame.MouseButton1Down, function() for _, s in next, stripes do s.Color = library.theme["Accent"] end end)
    utility.connect(frame.MouseButton1Up, function()
        for i, s in next, stripes do
            local t = (i-1)/math.max(#stripes-1,1)
            s.Color = Color3.fromRGB(
                math.floor(library.theme["ObjectTop"].R*255 + (library.theme["ObjectBottom"].R*255 - library.theme["ObjectTop"].R*255)*t),
                math.floor(library.theme["ObjectTop"].G*255 + (library.theme["ObjectBottom"].G*255 - library.theme["ObjectTop"].G*255)*t),
                math.floor(library.theme["ObjectTop"].B*255 + (library.theme["ObjectBottom"].B*255 - library.theme["ObjectTop"].B*255)*t))
        end
    end)
    return api
end

