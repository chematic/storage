function Library:prompt(opts)
	opts = self:set_defaults({Followup=false, Title="Prompt", Text="Are you sure?", Buttons={ok=function() return true end}}, opts)
	if Library._promptExists and not opts.Followup then return end
	Library._promptExists = true
	local cnt = 0; for _ in next, opts.Buttons do cnt = cnt + 1 end
	local dk = self.core:object("Frame", {BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=1, Size=UDim2.fromScale(1,1), ZIndex=300}):round(4)
	local pc = dk:object("Frame", {Theme={BackgroundColor3="Main"}, BackgroundTransparency=1, Centered=true, Size=UDim2.fromOffset(280,140), ZIndex=301}):round(3)
	pc:stroke({"Tertiary", -20}, 1)
	pc:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(12,8), Size=UDim2.new(1,-24,0,16), Text="> [ CONFIRM ] " .. opts.Title, TextSize=12, Font=Enum.Font.Code, Theme={TextColor3="Tertiary"}, TextXAlignment=Enum.TextXAlignment.Left, TextTransparency=1, ZIndex=302}).Name = "ptitle"
	pc:object("Frame", {Position=UDim2.fromOffset(0,28), Size=UDim2.new(1,0,0,1), Theme={BackgroundColor3={"Tertiary", -50}}, ZIndex=302})
	local px = pc:object("TextLabel", {AnchorPoint=Vector2.new(0.5,0), BackgroundTransparency=1, Position=UDim2.new(0.5,0,0,38), Size=UDim2.new(1,-24,1,-74), TextSize=12, Font=Enum.Font.Code, Theme={TextColor3="StrongText"}, Text=opts.Text, TextTransparency=1, TextYAlignment=Enum.TextYAlignment.Top, TextXAlignment=Enum.TextXAlignment.Center, TextWrapped=true, ZIndex=302})
	local bh = pc:object("Frame", {BackgroundTransparency=1, AnchorPoint=Vector2.new(0,1), Position=UDim2.new(0,0,1,-10), Size=UDim2.new(1,-20,0,22), ZIndex=302})
	bh:object("UIGridLayout", {CellPadding=UDim2.new(0,8,0,0), CellSize=UDim2.new(1/cnt,-8,1,0), FillDirection=Enum.FillDirection.Horizontal, HorizontalAlignment=Enum.HorizontalAlignment.Center})
	dk:tween({BackgroundTransparency=0.4, Length=0.1}); pc:tween({BackgroundTransparency=0, Length=0.1})
	px:tween({TextTransparency=0, Length=0.1})
	pc:FindFirstChild("ptitle").TextTransparency = 0
	local tmp = {}
	for text, cb in next, opts.Buttons do
		local b = bh:object("TextButton", {AnchorPoint=Vector2.new(1,1), Theme={BackgroundColor3="Tertiary"}, Text=tostring(text):upper(), TextSize=11, Font=Enum.Font.Code, BackgroundTransparency=1, TextTransparency=1, ZIndex=303}):round(2)
		b:stroke({"Tertiary", -20}, 1)
		table.insert(tmp, b); b:tween({TextTransparency=0, BackgroundTransparency=0})
		b.MouseButton1Click:connect(function()
			pc:tween({BackgroundTransparency=1, Length=0.1}); px:tween({TextTransparency=1, Length=0.1})
			for _, bb in next, tmp do bb:tween({TextTransparency=1, BackgroundTransparency=1, Length=0.1}) end
			dk:tween({BackgroundTransparency=1, Length=0.1}, function()
				pcall(function() dk.AbsoluteObject:Destroy() end)
				task.delay(0.2, function() Library._promptExists = false end)
				pcall(cb)
			end)
		end)
	end
end

