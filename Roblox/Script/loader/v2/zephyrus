--  WIDGETS
-- ═══════════════════════════════════════════════════════════════════════════
function Library:toggle(opts)
	opts = self:set_defaults({Name="Toggle", StartingState=false, Description=nil, Callback=function(s) end}, opts)
	local c, h = self:_widget_base(opts.Name, opts.Description)
	local tog = opts.StartingState
	local toggleFrame = c:object("Frame", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-12,0.5,0), Size=UDim2.fromOffset(36,18), Theme={BackgroundColor3="Secondary"}, ZIndex=10}):round(2)
	toggleFrame:stroke({"Tertiary", tog and 0 or -60}, 1)
	local knob = toggleFrame:object("Frame", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(tog and 1 or 0, tog and -14 or 4, 0.5, 0), Size=UDim2.fromOffset(10,10), Theme={BackgroundColor3="Tertiary"}, BackgroundTransparency=tog and 0 or 0.6, ZIndex=11}):round(1)
	local stateLabel = c:object("TextLabel", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-56,0.5,0), Size=UDim2.fromOffset(50,14), BackgroundTransparency=1, Text=tog and "ON" or "OFF", TextSize=10, Font=Enum.Font.Code, Theme={TextColor3="WeakText"}, TextXAlignment=Enum.TextXAlignment.Right, ZIndex=10})

	local function toggle()
		tog = not tog
		knob:tween({Position=UDim2.new(tog and 1 or 0, tog and -14 or 4, 0.5, 0), BackgroundTransparency=tog and 0 or 0.6, Length=0.12})
		toggleFrame:FindFirstChildOfClass("UIStroke").Color = tog and Library.CurrentTheme.Tertiary or Library.CurrentTheme.WeakText
		stateLabel.Text = tog and "ON" or "OFF"
		task.spawn(function() pcall(opts.Callback, tog) end)
	end
	c.MouseButton1Click:connect(toggle)
	self:_hover_style(c, Library.CurrentTheme.Secondary, self:lighten(Library.CurrentTheme.Secondary, 10), self:lighten(Library.CurrentTheme.Secondary, 18))
	self:_resize_tab()
	local api = {}
	function api:Toggle() toggle() end
	function api:SetState(s) if tog ~= s then toggle() end end
	if opts.StartingState then api:SetState(true) end
	return api
end

function Library:dropdown(opts)
	opts = self:set_defaults({Name="Dropdown", StartingText="Select...", Items={}, Callback=function(i) return end}, opts)
	local open = false
	local c, h = self:_widget_base(opts.Name, opts.Description)
	local ic = c:object("Frame", {BackgroundTransparency=1, Position=UDim2.fromOffset(12, h - 2), Size=UDim2.new(1,-24,0,0), ClipsDescendants=true, ZIndex=11})
	ic:object("UIListLayout", {Padding=UDim.new(0,2), SortOrder=Enum.SortOrder.LayoutOrder})
	local selT = c:object("TextLabel", {AnchorPoint=Vector2.new(1,0.5), Theme={BackgroundColor3={"Secondary",-20},TextColor3="Tertiary"}, Position=UDim2.new(1,-12,0.5,0), Size=UDim2.fromOffset(140,18), TextSize=11, Font=Enum.Font.Code, Text=opts.StartingText, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=10}):round(2):stroke({"Tertiary", -40}, 1)
	local marker = c:object("TextLabel", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-6,0.5,0), Size=UDim2.fromOffset(12,12), BackgroundTransparency=1, Text="v", TextSize=10, Font=Enum.Font.Code, Theme={TextColor3="WeakText"}, ZIndex=10})

	local items = {}
	for i, v in next, opts.Items do
		if typeof(v)=="table" then items[i] = v else items[i] = {tostring(v), v} end
	end
	local orderedKeys = {}
	for i in next, items do table.insert(orderedKeys, i) end
	table.sort(orderedKeys, function(a,b) return tostring(a) < tostring(b) end)
	local totalH = (#orderedKeys) * 22 + 4

	for _, k in ipairs(orderedKeys) do
		local item = items[k]
		local label, val = item[1], item[2]
		local ni = ic:object("TextButton", {Theme={BackgroundColor3={"Secondary",10},TextColor3="StrongText"}, Size=UDim2.new(1,0,0,20), Text="  " .. label, TextSize=11, Font=Enum.Font.Code, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=12}):round(2)
		ni.MouseButton1Click:connect(function()
			open = false
			ic:tween{Size=UDim2.new(1,-24,0,0)}
			c:tween({Size=UDim2.new(1,-20,0,h)}, function() self:_resize_tab() end)
			marker.Text = "v"
			selT.Text = label
			pcall(opts.Callback, val)
		end)
		ni.MouseEnter:connect(function() ni:tween{BackgroundColor3=Library.CurrentTheme.Tertiary, TextColor3=Library.CurrentTheme.Main} end)
		ni.MouseLeave:connect(function() ni:tween{BackgroundColor3=self:lighten(Library.CurrentTheme.Secondary,10), TextColor3=Library.CurrentTheme.StrongText} end)
	end

	c.MouseButton1Click:connect(function()
		open = not open
		if open then
			ic:tween{Size=UDim2.new(1,-24,0,totalH)}
			c:tween({Size=UDim2.new(1,-20,0,h + totalH + 4)}, function() self:_resize_tab() end)
			marker.Text = "^"
		else
			ic:tween{Size=UDim2.new(1,-24,0,0)}
			c:tween({Size=UDim2.new(1,-20,0,h)}, function() self:_resize_tab() end)
			marker.Text = "v"
		end
	end)
	self:_resize_tab()
	local api = {}
	function api:Set(t) selT.Text = t end
	function api:Get() return selT.Text end
	return api
end

function Library:combo(opts)
	opts = self:set_defaults({Name="Combo", Description=nil, Items={}, DefaultSelected=nil, Callback=function(s) end}, opts)
	local c, h = self:_widget_base(opts.Name, opts.Description)
	local summary = c:object("TextLabel", {AnchorPoint=Vector2.new(1,0.5), Theme={BackgroundColor3={"Secondary",-20},TextColor3="WeakText"}, Position=UDim2.new(1,-12,0.5,0), Size=UDim2.fromOffset(140,18), TextSize=11, Font=Enum.Font.Code, Text="none", TextXAlignment=Enum.TextXAlignment.Center, ZIndex=10}):round(2):stroke({"Tertiary", -40}, 1)
	local ic = c:object("Frame", {BackgroundTransparency=1, Position=UDim2.fromOffset(12, h - 2), Size=UDim2.new(1,-24,0,0), ClipsDescendants=true, ZIndex=11})
	ic:object("UIListLayout", {Padding=UDim.new(0,2), SortOrder=Enum.SortOrder.LayoutOrder})
	local state, checkboxes, open = {}, {}, false
	for i, item in next, opts.Items do
		local label = typeof(item)=="table" and item[1] or tostring(item)
		local val = typeof(item)=="table" and item[2] or item
		state[val] = false
		if opts.DefaultSelected and table.find(opts.DefaultSelected, val) then state[val] = true end
		local row = ic:object("TextButton", {Theme={BackgroundColor3={"Secondary",10},TextColor3="StrongText"}, Text="", Size=UDim2.new(1,0,0,20), ZIndex=12}):round(2)
		local mark = row:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(4,0), Size=UDim2.fromOffset(16,20), Text=state[val] and "[x]" or "[ ]", TextSize=11, Font=Enum.Font.Code, Theme={TextColor3="Tertiary"}, TextXAlignment=Enum.TextXAlignment.Left, ZIndex=13})
		row:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(24,0), Size=UDim2.new(1,-28,1,0), Text=label, TextSize=11, Font=Enum.Font.Code, TextXAlignment=Enum.TextXAlignment.Left, Theme={TextColor3="StrongText"}, ZIndex=13})
		checkboxes[val] = {row=row, mark=mark, label=label}
		local function upd()
			local parts = {}
			for v, o in next, state do if o then table.insert(parts, checkboxes[v].label) end end
			summary.Text = #parts == 0 and "none" or (#parts <= 2 and table.concat(parts, ", ") or #parts .. " selected")
			pcall(opts.Callback, state)
		end
		row.MouseButton1Click:connect(function()
			state[val] = not state[val]
			mark.Text = state[val] and "[x]" or "[ ]"
			upd()
		end)
		row.MouseEnter:connect(function() row:tween{BackgroundColor3=self:lighten(Library.CurrentTheme.Secondary, 15)} end)
		row.MouseLeave:connect(function() row:tween{BackgroundColor3=self:lighten(Library.CurrentTheme.Secondary, 10)} end)
	end
	local totalH = 22 * #opts.Items + 4
	c.MouseButton1Click:connect(function()
		open = not open
		if open then
			ic:tween{Size=UDim2.new(1,-24,0,totalH)}
			c:tween({Size=UDim2.new(1,-20,0,h + totalH + 4)}, function() self:_resize_tab() end)
		else
			ic:tween{Size=UDim2.new(1,-24,0,0)}
			c:tween({Size=UDim2.new(1,-20,0,h)}, function() self:_resize_tab() end)
		end
	end)
	self:_resize_tab()
	local api = {}
	function api:Get() return state end
	function api:Set(vs)
		for k in next, state do state[k] = false end
		for _, v in next, vs do if state[v] ~= nil then state[v] = true end end
		for val, cb in next, checkboxes do cb.mark.Text = state[val] and "[x]" or "[ ]" end
		pcall(opts.Callback, state)
	end
	return api
end

