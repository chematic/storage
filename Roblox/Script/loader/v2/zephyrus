list_sec:new_dropdown({
    name    = "Choose a fruit",
    list    = true,
    size    = 130,
    options = { "Apple", "Banana", "Cherry", "Date", "Elderberry", "Fig", "Grape", "Honeydew", "Kiwi", "Lemon" },
