function Library:create(opts)
	local settings = {Theme="Dark"}
	if readfile and writefile and isfile then
		if not isfile("AzunoSettings.json") then writefile("AzunoSettings.json", HTTPService:JSONEncode(settings)) end
		local ok, decoded = pcall(function() return HTTPService:JSONDecode(readfile("AzunoSettings.json")) end)
		if ok and decoded and decoded.Theme and Library.Themes[decoded.Theme] then settings = decoded end
		Library.CurrentTheme = Library.Themes[settings.Theme]
		updateSettings = function(p, v) settings[p]=v; pcall(function() writefile("AzunoSettings.json", HTTPService:JSONEncode(settings)) end) end
	end
	opts = self:set_defaults({Name="AZUNO", Size=UDim2.fromOffset(620,420), Theme=self.Themes[settings.Theme] or self.Themes.Dark, Link="https://github.com/azunoo/azuno-lib"}, opts)
	if getgenv and getgenv().AzunoUI then pcall(getgenv().AzunoUI); getgenv().AzunoUI = nil end
	if opts.Link:sub(-1,-1) == "/" then opts.Link = opts.Link:sub(1,-2) end
	if opts.Theme.Light then self.darken, self.lighten = self.lighten, self.darken end
	self.CurrentTheme = opts.Theme
	Library._dead = false

	local isHacker = (opts.Theme == Library.Themes.Hacker)

	local gui = self:object("ScreenGui", {Parent=(RunService:IsStudio() and LocalPlayer.PlayerGui) or game:GetService("CoreGui"), ZIndexBehavior=Enum.ZIndexBehavior.Global, Name="AzunoUI", IgnoreGuiInset=true})
	local notiHolder = gui:object("Frame", {AnchorPoint=Vector2.new(1,1), BackgroundTransparency=1, Position=UDim2.new(1,-24,1,-24), Size=UDim2.new(0,320,1,-48), ZIndex=1000})
	notiHolder:object("UIListLayout", {Padding=UDim.new(0,10), VerticalAlignment=Enum.VerticalAlignment.Bottom, SortOrder=Enum.SortOrder.LayoutOrder})

	local core = gui:object("Frame", {Size=UDim2.new(), Theme={BackgroundColor3="Main"}, Centered=true, ClipsDescendants=true, ZIndex=5}):round(4)
	core:stroke({"Tertiary", -55}, 1)
	core:fade(true, nil, 0.2, true); core:fade(false, nil, 0.35)
	core:tween({Size=opts.Size, Length=0.28}, function() core.ClipsDescendants = false end)

	-- ═══════════════════════════════════════════════════════════════════════════
	--  HACKER BACKGROUND — SUBTLE TERMINAL MATRIX
	-- ═══════════════════════════════════════════════════════════════════════════
	local hackerBg = core:object("Frame", {Size=UDim2.new(1,-2,1,-2), Position=UDim2.new(0,1,0,1), BackgroundTransparency=1, Visible=isHacker, ZIndex=2, ClipsDescendants=true})
	Library._hackerBg = hackerBg
	local bgAnim = {visible = isHacker}

	if isHacker then
		-- Rain characters (slightly biased toward 0/1)
		local rainChars = {"0","1","0","1",">","<","/","\\","|","$","#","%","&","*","+","-","=",":",";","."}
		local NUM_COLS = 24
		local CHARS_PER_COL = 44
		local columns = {}
		local colWidth = 22

		for i = 1, NUM_COLS do
			local tl = hackerBg:object("TextLabel", {
				BackgroundTransparency = 1, Text = "",
				TextColor3 = ACCENT, TextTransparency = 0.72,
				Size = UDim2.new(0, colWidth, 0, 26 * CHARS_PER_COL),
				Position = UDim2.new((i - 1) / NUM_COLS, 0, 0, math.random(-1200, 0)),
				TextSize = 14, Font = Enum.Font.Code,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Top,
				ZIndex = 3,
			})
			local chars = {}
			for j = 1, CHARS_PER_COL do chars[j] = rainChars[math.random(1, #rainChars)] end
			tl.Text = table.concat(chars, "\n")
			table.insert(columns, {
				obj = tl, chars = chars,
				y = tl.Position.Y.Offset,
				speed = math.random(28, 75),
				changeTimer = math.random(10, 60) / 10,
				baseTransparency = 0.68 + math.random() * 0.14,
			})
		end

		-- Fine scanlines
		local scanGroup = hackerBg:object("Frame", {Size=UDim2.new(1,0,1,0), BackgroundTransparency=1, ZIndex=4})
		for i = 1, 60 do
			scanGroup:object("Frame", {BackgroundColor3=ACCENT, BackgroundTransparency=0.965, Size=UDim2.new(1,0,0,1), Position=UDim2.new(0,0,i/60,0), BorderSizePixel=0, ZIndex=4})
		end

		-- Very soft CRT dark overlay
		local crtOverlay = hackerBg:object("Frame", {BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.86, Size=UDim2.new(1,0,1,0), ZIndex=5, BorderSizePixel=0})

		-- Slow moving scanline
		local movingScanline = hackerBg:object("Frame", {BackgroundColor3=ACCENT, BackgroundTransparency=0.9, Size=UDim2.new(1,0,0,2), Position=UDim2.new(0,0,0,-10), BorderSizePixel=0, ZIndex=5})

		-- Static hex telemetry (few, tucked away)
		local hexLabels = {}
		for i = 1, 4 do
			local hex = hackerBg:object("TextLabel", {
				BackgroundTransparency=1, Text="0x0000", TextColor3=ACCENT,
				TextTransparency=0.82, Size=UDim2.new(0,60,0,12),
				Position=UDim2.new(0.02 + i*0.24, 0, 0.94, 0),
				TextSize=10, Font=Enum.Font.Code,
				TextXAlignment=Enum.TextXAlignment.Left, ZIndex=6,
			})
			table.insert(hexLabels, {obj=hex, timer=math.random(30, 120)})
		end

		-- Layer behind content — no ZIndex above 6

		-- Cleanup old connection
		if Library._hackerConn then pcall(function() Library._hackerConn:Disconnect() end) end

		-- ═══ ANIMATION — SINGLE HEARTBEAT ═══
		Library._hackerConn = RunService.Heartbeat:Connect(function(dt)
			if Library._dead or not Library._hackerBg or not Library._hackerBg.AbsoluteObject or not Library._hackerBg.AbsoluteObject.Parent then
				if Library._hackerConn then pcall(function() Library._hackerConn:Disconnect() end); Library._hackerConn = nil end
				return
			end
			if not Library._hackerBg.Visible then return end
			dt = math.min(dt or 0.016, 0.05)

			local absH = hackerBg.AbsoluteSize.Y

			-- Matrix scroll (per column, smooth)
			for _, col in ipairs(columns) do
				col.y = col.y + col.speed * dt
				if col.y > absH then
					col.y = -26 * CHARS_PER_COL
					for j = 1, CHARS_PER_COL do col.chars[j] = rainChars[math.random(1, #rainChars)] end
					col.obj.Text = table.concat(col.chars, "\n")
				end
				col.obj.Position = UDim2.new(col.obj.Position.X.Scale, 0, 0, col.y)

				-- Per-column random character mutation (per-char, staggered timers)
				col.changeTimer = col.changeTimer - dt
				if col.changeTimer <= 0 then
					col.changeTimer = math.random(3, 12) / 10
					local n = math.random(1, 3)
					local changed = false
					for _ = 1, n do
						local idx = math.random(1, CHARS_PER_COL)
						if col.chars[idx] ~= rainChars[1] then
							col.chars[idx] = rainChars[math.random(1, #rainChars)]
							changed = true
						end
					end
					if changed then col.obj.Text = table.concat(col.chars, "\n") end
					-- Subtle brightness shift per mutation
					col.obj.TextTransparency = col.baseTransparency + math.random() * 0.06 - 0.03
				end
			end

			-- Rare CRT flicker
			if math.random() < 0.08 then
				crtOverlay.BackgroundTransparency = 0.84 + math.random() * 0.05
			end

			-- Moving scanline
			local sY = movingScanline.Position.Y.Offset + 160 * dt
			if sY > absH + 5 then sY = -5 end
			movingScanline.Position = UDim2.new(0, 0, 0, sY)

			-- Hex telemetry
			for _, h in ipairs(hexLabels) do
				h.timer = h.timer - 1
				if h.timer <= 0 then
					h.timer = math.random(60, 180)
					h.obj.Text = "0x" .. string.format("%04X", math.random(0, 65535))
				end
			end
		end)
	end

	-- ═══ DRAG — PRESERVED ═══
	do
		local S, Ev = pcall(function() return core.MouseEnter end)
		if S then
			core.Active = true
			Ev:connect(function()
				local In = core.InputBegan:connect(function(K)
					if K.UserInputType == Enum.UserInputType.MouseButton1 then
						local OP = Vector2.new(Mouse.X - core.AbsolutePosition.X, Mouse.Y - core.AbsolutePosition.Y)
						while RunService.RenderStepped:wait() and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) do
							if Library.LockDragging then
								local FX, FY = math.clamp(Mouse.X - OP.X, 0, gui.AbsoluteSize.X - core.AbsoluteSize.X), math.clamp(Mouse.Y - OP.Y, 0, gui.AbsoluteSize.Y - core.AbsoluteSize.Y)
								core:tween{Position=UDim2.fromOffset(FX + (core.Size.X.Offset*core.AnchorPoint.X), FY + (core.Size.Y.Offset*core.AnchorPoint.Y)), Length=Library.DragSpeed}
							else
								core:tween{Position=UDim2.fromOffset(Mouse.X - OP.X + (core.Size.X.Offset*core.AnchorPoint.X), Mouse.Y - OP.Y + (core.Size.Y.Offset*core.AnchorPoint.Y)), Length=Library.DragSpeed}
							end
						end
					end
				end)
				local L; L = core.MouseLeave:connect(function() In:disconnect(); L:disconnect() end)
			end)
		end
	end
	rawset(core, "oldSize", opts.Size); self.mainFrame = core

	-- ═══ TITLE BAR ═══
