						NumberSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
						NumberSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)),
					}),
					Rotation = 0,
				}, hue)
				local hueIndicator = mk("Frame", { Size = UDim2.new(0, 4, 0, 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(hh, 0, 0.5, 0), BackgroundColor3 = Color3.new(1,1,1), Parent = hue })
				rc(hueIndicator, 2); sk(hueIndicator, Color3.new(0,0,0), 2)
				local hueHit = mk("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = hue })

				-- FIX #6: skip darkLayer when refreshing SV (avoid overwriting black)
				local function refreshSV()
					sv.BackgroundColor3 = Color3.fromHSV(hh, 1, 1)
					whiteOverlay.BackgroundColor3 = Color3.new(1, 1, 1)
					whiteGradient.Color = ColorSequence.new({ NumberSequenceKeypoint.new(0, Color3.new(1, 1, 1)), NumberSequenceKeypoint.new(1, Color3.fromHSV(hh, 1, 1)) })
					svIndicator.Position = UDim2.new(ss, 0, 1 - vv, 0)
					hueIndicator.Position = UDim2.new(hh, 0, 0.5, 0)
				end
				refreshSV()

				local function updateFromSV(px, py)
					local a = sv.AbsolutePosition; local s2 = sv.AbsoluteSize
					ss = math.clamp((px - a.X) / s2.X, 0, 1)
					vv = 1 - math.clamp((py - a.Y) / s2.Y, 0, 1)
					svIndicator.Position = UDim2.new(ss, 0, 1 - vv, 0)
					applyColor(Color3.fromHSV(hh, ss, vv), true, true)
				end
				svHit.InputBegan:Connect(function(i)
					if h._disabled then return end
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
						dragMode = true; dragWhich = "sv"; updateFromSV(i.Position.X, i.Position.Y)
					end
				end)
				hueHit.InputBegan:Connect(function(i)
					if h._disabled then return end
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
						dragMode = true; dragWhich = "hue"
						local a = hue.AbsolutePosition; local s2 = hue.AbsoluteSize
						hh = math.clamp((i.Position.X - a.X) / s2.X, 0, 1)
						refreshSV()
						applyColor(Color3.fromHSV(hh, ss, vv), true, true)
					end
				end)
				outsideConn = UIS.InputChanged:Connect(function(i)
					if dragMode and dragWhich == "sv" and i.UserInputType == Enum.UserInputType.MouseMovement then
						updateFromSV(i.Position.X, i.Position.Y)
					elseif dragMode and dragWhich == "hue" and i.UserInputType == Enum.UserInputType.MouseMovement then
						local a = hue.AbsolutePosition; local s2 = hue.AbsoluteSize
						hh = math.clamp((i.Position.X - a.X) / s2.X, 0, 1)
						refreshSV()
						applyColor(Color3.fromHSV(hh, ss, vv), true, true)
					end
				end)
				-- FIX #14: tie endConn to popup lifetime
				local endConn
				endConn = UIS.InputEnded:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 then dragMode = false; dragWhich = nil end
				end)
				popup.Destroying:Once(function()
					if endConn then pcall(function() endConn:Disconnect() end) end
				end)

				local prev = mk("Frame", { Size = UDim2.new(0, 30, 0, 20), Position = UDim2.new(0, 0, 0, 162), BackgroundColor3 = h.v, Parent = popup })
				rc(prev, 4); sk(prev, K.ln, 1)
				local hex = mk("TextBox", { Size = UDim2.new(0, 100, 0, 20), Position = UDim2.new(0, 38, 0, 162), BackgroundColor3 = K.bg, Text = string.format("#%02X%02X%02X", math.floor(h.v.R*255), math.floor(h.v.G*255), math.floor(h.v.B*255)), TextColor3 = K.tx, Font = K.fontMed, TextSize = 10, ClearTextOnFocus = false, Parent = popup })
				rc(hex, 4); sk(hex, K.ln, 1)
				local applyBtn = mk("TextButton", { Size = UDim2.new(0, 88, 0, 20), Position = UDim2.new(1, -88, 0, 162), BackgroundColor3 = K.ac, Text = "Apply", TextColor3 = Color3.new(1,1,1), Font = K.fontBold, TextSize = 11, AutoButtonColor = false, Parent = popup })
				rc(applyBtn, 4)

				hex.FocusLost:Connect(function(enter)
					if not enter then return end
					local s2 = hex.Text:gsub("#", "")
					if #s2 == 6 then
						local r = tonumber(s2:sub(1, 2), 16); local g = tonumber(s2:sub(3, 4), 16); local b = tonumber(s2:sub(5, 6), 16)
						if r and g and b then
							local c = Color3.fromRGB(r, g, b)
							hh, ss, vv = c:ToHSV()
							refreshSV(); prev.BackgroundColor3 = c
							applyColor(c, true, true)
						end
					end
				end)

				local presets = {
					Color3.fromRGB(255, 107, 53), Color3.fromRGB(255, 60, 60), Color3.fromRGB(255, 200, 60), Color3.fromRGB(90, 220, 130),
					Color3.fromRGB(90, 180, 255), Color3.fromRGB(170, 120, 255), Color3.fromRGB(255, 120, 200), Color3.fromRGB(200, 200, 200),
				}
				for i, c in ipairs(presets) do
					local b = mk("TextButton", { Size = UDim2.new(0, 26, 0, 20), Position = UDim2.new(0, (i-1) * 29, 1, -20), BackgroundColor3 = c, Text = "", AutoButtonColor = false, Parent = popup })
					rc(b, 4); sk(b, K.ln, 1, 0.3)
					b.MouseButton1Click:Connect(function()
						local nhh, nss, nvv = c:ToHSV()
						hh, ss, vv = nhh, nss, nvv
						refreshSV(); prev.BackgroundColor3 = c
						applyColor(c, true, true)
					end)
				end

				applyBtn.MouseButton1Click:Connect(function()
					applyColor(Color3.fromHSV(hh, ss, vv), true, true)
					closePopup()
				end)
			end)
			function h:get() return h.v end
			function h:set(c) h.v = c; swatch.BackgroundColor3 = c; notifyChange(h, c, false); return self end
			h._serialize = function() return { r = h.v.R, g = h.v.G, b = h.v.B } end
			h._deserialize = function(val) if type(val) == "table" and val.r and val.g and val.b then h:set(Color3.new(val.r, val.g, val.b)) end end
			h._reset = function() h:set(h._default) end
			local pid = opts.PersistId .. "/" .. (id or t)
			Library._registry[pid] = h; h._id = pid
			self._handles[t] = h
			return h
		end

