        hue_cur = utility.create("Square", {
            Parent = window, Filled = false, Thickness = 1, Color = Color3.fromRGB(255, 255, 255),
            Size = UDim2.new(0, HUE_W + 2, 0, 3), Position = UDim2.new(0, HUE_X - 1, 0, SV_Y), ZIndex = 24,
        })

        preview = utility.create("Square", {
            Parent = window, Filled = true, Thickness = 1, Color = default,
            Size = UDim2.new(0, 50, 0, 20), Position = UDim2.new(0, 6, 0, 164), ZIndex = 23,
        })
        utility.outline(preview, "SectionBorder")

        rgb_text = utility.create("Text", {
            Parent = window, Text = "", Size = 13, Theme = "Text",
            Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0), Font = PLEX,
            Position = UDim2.new(0, 62, 0, 166), ZIndex = 24,
        })

        local copy_btn = utility.create("Square", {
            Parent = window, Filled = true, Thickness = 0, Color = Color3.fromRGB(30, 30, 30),
            Size = UDim2.new(0, 85, 0, 22), Position = UDim2.new(0, 6, 0, 190), ZIndex = 23,
        })
        utility.create("Text", {
            Parent = copy_btn, Text = "copy", Size = 13, Center = true, Theme = "Text",
            Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0), Font = PLEX,
            Position = UDim2.new(0.5, 0, 0, 3), ZIndex = 24,
        })
        local paste_btn = utility.create("Square", {
            Parent = window, Filled = true, Thickness = 0, Color = Color3.fromRGB(30, 30, 30),
            Size = UDim2.new(0, 85, 0, 22), Position = UDim2.new(0, 99, 0, 190), ZIndex = 23,
        })
        utility.create("Text", {
            Parent = paste_btn, Text = "paste", Size = 13, Center = true, Theme = "Text",
            Outline = true, OutlineColor = Color3.fromRGB(0, 0, 0), Font = PLEX,
            Position = UDim2.new(0.5, 0, 0, 3), ZIndex = 24,
        })

        update_preview = function()
            local c = Color3.fromHSV(hue, sat, val)
            preview.Color = c; icon.Color = c
            rgb_text.Text = string.format("%d, %d, %d",
                math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
        end

        local sliding_sv, sliding_hue = false, false
        local function do_sv(input)
            local rx = math.clamp((input.Position.X - SV_X - window.AbsolutePosition.X) / SV_SZ, 0, 1)
            local ry = math.clamp((input.Position.Y - SV_Y - window.AbsolutePosition.Y) / SV_SZ, 0, 1)
            sat, val = rx, 1 - ry
            sv_cur.Position = UDim2.new(0, SV_X + math.floor(sat * (SV_SZ - 4)), 0, SV_Y + math.floor((1 - val) * (SV_SZ - 4)))
            update_preview(); current_val = Color3.fromHSV(hue, sat, val); callback(current_val)
        end
        local function do_hue(input)
            local ry = math.clamp((input.Position.Y - SV_Y - window.AbsolutePosition.Y) / SV_SZ, 0, 1)
            hue = 1 - ry
            refresh_sv(hue)
            hue_cur.Position = UDim2.new(0, HUE_X - 1, 0, SV_Y + math.floor((1 - hue) * (SV_SZ - 3)))
            update_preview(); current_val = Color3.fromHSV(hue, sat, val); callback(current_val)
        end

        utility.connect(services.InputService.InputBegan, function(input)
            if not window.Visible or input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            local mx, my = input.Position.X, input.Position.Y
            local wx, wy = window.AbsolutePosition.X, window.AbsolutePosition.Y
            if mx >= wx + SV_X and mx <= wx + SV_X + SV_SZ and my >= wy + SV_Y and my <= wy + SV_Y + SV_SZ then
                sliding_sv = true; do_sv(input)
            elseif mx >= wx + HUE_X and mx <= wx + HUE_X + HUE_W and my >= wy + SV_Y and my <= wy + SV_Y + SV_SZ then
                sliding_hue = true; do_hue(input)
            end
        end)
        utility.connect(services.InputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding_sv, sliding_hue = false, false end
        end)
        utility.connect(services.InputService.InputChanged, function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            if sliding_sv then do_sv(input) end
            if sliding_hue then do_hue(input) end
        end)

        utility.connect(copy_btn.MouseButton1Click, function() library.currentcolor = current_val end)
        utility.connect(paste_btn.MouseButton1Click, function() if library.currentcolor then set(library.currentcolor, false) end end)

        -- Sync vers l'état courant
        refresh_sv(hue)
        sv_cur.Position = UDim2.new(0, SV_X + math.floor(sat * (SV_SZ - 4)), 0, SV_Y + math.floor((1 - val) * (SV_SZ - 4)))
        hue_cur.Position = UDim2.new(0, HUE_X - 1, 0, SV_Y + math.floor((1 - hue) * (SV_SZ - 3)))
        update_preview()
    end

    local function set(color, skip_pos)
        if type(color) == "table" then color = Color3.fromRGB(color[1], color[2], color[3]) end
        if type(color) == "string" then color = Color3.fromHex(color) end
        hue, sat, val = color:ToHSV()
        current_val = Color3.fromHSV(hue, sat, val)
        icon.Color = current_val
        if flag then library.flags[flag] = utility.rgba(
            math.floor(current_val.R*255), math.floor(current_val.G*255), math.floor(current_val.B*255)) end
        callback(current_val)
        if built then
            refresh_sv(hue)
            if not skip_pos then
                sv_cur.Position = UDim2.new(0, SV_X + math.floor(sat * (SV_SZ - 4)), 0, SV_Y + math.floor((1 - val) * (SV_SZ - 4)))
                hue_cur.Position = UDim2.new(0, HUE_X - 1, 0, SV_Y + math.floor((1 - hue) * (SV_SZ - 3)))
            end
            update_preview()
        end
    end
    set(default)

    utility.connect(icon.MouseButton1Click, function()
        build()
        for _, p in next, pickers do if p ~= window then p.Visible = false end end
        window.Visible = not window.Visible
    end)

    local cpt = {}
    function cpt:set(color) set(color) end
    return cpt
end

