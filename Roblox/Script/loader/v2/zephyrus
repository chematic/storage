function Library:color_picker(opts)
	opts = self:set_defaults({Name="Color Picker", Description=nil, Style=Library.ColorPickerStyles.Legacy, Followup=false, Callback=function(c) end}, opts)
	local c, h = self:_widget_base(opts.Name, opts.Description)
	local preview = c:object("Frame", {AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-12,0.5,0), Size=UDim2.fromOffset(40,18), BackgroundColor3=Library.CurrentTheme.Tertiary, ZIndex=10}):round(2)
	preview:stroke({"Tertiary", -30}, 1)
	c.MouseButton1Click:connect(function()
		if Library._colorPickerExists then return end
		Library._colorPickerExists = true
		local hue, sat, val = 0, 1, 1
		local selectedColor = Color3.fromRGB(255,0,0)
		local fadeOut
		local darkener = self.core:object("Frame", {BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=1, Size=UDim2.fromScale(1,1), ZIndex=200}):round(4)
		local holder = darkener:object("Frame", {Centered=true, Theme={BackgroundColor3="Main"}, BackgroundTransparency=1, Size=UDim2.fromOffset(280,190), ZIndex=201}):round(3)
		holder:stroke({"Tertiary", -20}, 1)
		holder:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(10,6), Size=UDim2.new(1,-20,0,16), Text="> color picker :: hsv", TextSize=11, Font=Enum.Font.Code, Theme={TextColor3="Tertiary"}, TextXAlignment=Enum.TextXAlignment.Left, TextTransparency=1, ZIndex=202}).Name = "hdr"
		holder:object("Frame", {Position=UDim2.fromOffset(0, 24), Size=UDim2.new(1,0,0,1), Theme={BackgroundColor3={"Tertiary", -40}}, ZIndex=202})

		local sv = holder:object("TextButton", {Text="", BackgroundColor3=selectedColor, BackgroundTransparency=1, Position=UDim2.fromOffset(10,32), Size=UDim2.fromOffset(200,140), ZIndex=203}):round(2)
		sv:object("Frame", {Size=UDim2.fromScale(1,1), ZIndex=204, BackgroundColor3=Color3.fromRGB(255,255,255), BackgroundTransparency=1}):round(2).Parent.Name = "grad"
		local grad = sv:FindFirstChild("grad")
		grad:object("UIGradient", {Color=ColorSequence.new(Color3.fromRGB(255,255,255)), Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)})})
		local blk = sv:object("Frame", {Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0), ZIndex=205}):round(2)
		blk:object("UIGradient", {Color=ColorSequence.new(Color3.new(0,0,0)), Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(1,1)}), Rotation=-90})
		local cpd = sv:object("Frame", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(0,1), Size=UDim2.fromOffset(8,8), BackgroundTransparency=1, ZIndex=210}):round(1)
		cpd:object("UIStroke", {Color=Color3.new(1,1,1), Thickness=2})

		local hueBar = holder:object("TextButton", {Text="", BackgroundColor3=Color3.new(1,1,1), Position=UDim2.fromOffset(218,32), Size=UDim2.fromOffset(20,140), ZIndex=203}):round(2)
		hueBar:object("UIGradient", {Rotation=90, Color=ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
			ColorSequenceKeypoint.new(1/6, Color3.fromRGB(255,255,0)),
			ColorSequenceKeypoint.new(2/6, Color3.fromRGB(0,255,0)),
			ColorSequenceKeypoint.new(3/6, Color3.fromRGB(0,255,255)),
			ColorSequenceKeypoint.new(4/6, Color3.fromRGB(0,0,255)),
			ColorSequenceKeypoint.new(5/6, Color3.fromRGB(255,0,255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)),
		})})
		local hd = hueBar:object("Frame", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0.5,0,0,0), Size=UDim2.new(1,4,0,4), BackgroundTransparency=1, ZIndex=210}):round(1)
		hd:object("UIStroke", {Color=Color3.new(1,1,1), Thickness=2})

		local rgb = holder:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(10, 178), Size=UDim2.new(1,-80,0,12), Text="R:255 G:0 B:0", TextSize=11, Font=Enum.Font.Code, Theme={TextColor3="WeakText"}, TextXAlignment=Enum.TextXAlignment.Left, TextTransparency=1, ZIndex=204})
		local pick = holder:object("TextButton", {Position=UDim2.new(1,-10,0,175), Size=UDim2.fromOffset(60,18), Theme={BackgroundColor3="Tertiary",TextColor3="Main"}, Text="APPLY", TextSize=11, Font=Enum.Font.Code, AnchorPoint=Vector2.new(1,0), BackgroundTransparency=1, TextTransparency=1, ZIndex=205}):round(2)

		local function update()
			local c = Color3.fromHSV(hue, sat, val)
			rgb.Text = string.format("R:%d G:%d B:%d", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
			preview.BackgroundColor3 = c
			selectedColor = c
		end

		local drag1, drag2 = false, false
		sv.MouseButton1Down:connect(function() drag1 = true
			while drag1 and sv.AbsoluteObject.Parent do
				local x = math.clamp((Mouse.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
				local y = math.clamp((Mouse.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
				sat, val = x, 1 - y
				cpd.Position = UDim2.fromScale(x, y)
				update()
				RunService.RenderStepped:Wait()
			end
		end)
		hueBar.MouseButton1Down:connect(function() drag2 = true
			while drag2 and hueBar.AbsoluteObject.Parent do
				local y = math.clamp((Mouse.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
				hue = y
				hd.Position = UDim2.new(0.5,0, y, 0)
				sv.BackgroundColor3 = Color3.fromHSV(y, 1, 1)
				update()
				RunService.RenderStepped:Wait()
			end
		end)
		UserInputService.InputEnded:connect(function(k) if k.UserInputType == Enum.UserInputType.MouseButton1 then drag1 = false; drag2 = false end end)

		fadeOut = function()
			holder:tween({BackgroundTransparency=1, Length=0.1})
			darkener:tween({BackgroundTransparency=1, Length=0.1}, function() task.delay(0.2, function() pcall(function() darkener.AbsoluteObject:Destroy() end) end) end)
		end
		pick.MouseButton1Click:connect(function()
			update()
			fadeOut()
			pcall(opts.Callback, selectedColor)
			task.delay(0.3, function() Library._colorPickerExists = false end)
		end)

		holder:tween({BackgroundTransparency=0, Length=0.1})
		sv.BackgroundTransparency = 0; blk.BackgroundTransparency = 0; grad.BackgroundTransparency = 0
		hd.BackgroundTransparency = 0; cpd.BackgroundTransparency = 0
		rgb.TextTransparency = 0
		pick.BackgroundTransparency = 0; pick.TextTransparency = 0
		darkener:tween({BackgroundTransparency=0.5, Length=0.1})
		for _, d in ipairs(holder:GetDescendants()) do pcall(function() if d.Name == "hdr" then d.TextTransparency = 0 end end) end
	end)
	self:_resize_tab()
end
