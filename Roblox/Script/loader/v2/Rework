local soundPools = {}
local function sn(id, v, pitch)
	local key = tostring(id)
	local pool = soundPools[key]
	if not pool then pool = {}; soundPools[key] = pool end
	local s = nil
	for i = 1, #pool do if not pool[i].IsPlaying then s = pool[i]; break end end
	if not s then
		if #pool < 3 then
			s = Instance.new("Sound"); s.SoundId = "rbxassetid://" .. key; s.Parent = SS
			table.insert(pool, s)
		else s = pool[1] end
	end
	s.Volume = v or 0.3; s.PlaybackSpeed = pitch or 1; s.TimePosition = 0; s:Play()
end

local function fadeDestroy(inst, dur)
	if not inst or not inst.Parent then return end
	dur = dur or 0.25
	local tInfo = TweenInfo.new(dur, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	pcall(function()
		for _, c in ipairs(inst:GetDescendants()) do
			if c:IsA("GuiObject") then
				if c.BackgroundTransparency ~= 1 then TS:Create(c, tInfo, { BackgroundTransparency = 1 }):Play() end
				if c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then
					TS:Create(c, tInfo, { TextTransparency = 1 }):Play()
				end
			elseif c:IsA("UIStroke") then TS:Create(c, tInfo, { Transparency = 1 }):Play() end
		end
	end)
	if inst:IsA("GuiObject") then
		pcall(function() TS:Create(inst, tInfo, { BackgroundTransparency = 1 }):Play() end)
	end
	task.delay(dur + 0.05, function() if inst and inst.Parent then inst:Destroy() end end)
end

