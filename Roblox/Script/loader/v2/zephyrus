function Library:config_manager(tab, opts)
	opts = self:set_defaults({Folder="AzunoConfigs", Extension=".json", Serialize=function() return {} end, Deserialize=function(t) end}, opts)
	if isfolder and not isfolder(opts.Folder) then pcall(function() makefolder(opts.Folder) end) end
	local function getC()
		local l = {}
		pcall(function()
			for _, f in next, listfiles(opts.Folder) do
				if f:sub(-#opts.Extension) == opts.Extension then
					local name = f:sub(#opts.Folder + 2, -#opts.Extension - 1)
					table.insert(l, name)
				end
			end
		end)
		return l
	end
	local cn, cs, cfg = "default", 1, getC()
	tab:divider({Text="CONFIG"})
	tab:textbox({Name="Config Name", Placeholder="> name...", Callback=function(t) cn = t end})
	tab:dropdown({Name="Load Config", StartingText=cfg[1] or "empty", Items=cfg, Callback=function(i) cs = i end})
	tab:button({Name="Save Config", Callback=function()
		if cn == "" then Library:notification({Title="Error", Text="config name empty", Duration=3}); return end
		pcall(function()
			local d = opts.Serialize()
			writefile(opts.Folder.."/"..cn..opts.Extension, HTTPService:JSONEncode(d))
			cfg = getC()
			Library:notification({Title="Saved", Text=cn, Duration=3})
		end)
	end})
	tab:button({Name="Load Config", Callback=function()
		local p = opts.Folder.."/"..cs..opts.Extension
		if not (isfile and isfile(p)) then Library:notification({Title="Error", Text="not found", Duration=3}); return end
		pcall(function()
			local d = HTTPService:JSONDecode(readfile(p))
			opts.Deserialize(d)
			Library:notification({Title="Loaded", Text=cs, Duration=3})
		end)
	end})
	tab:button({Name="Delete Config", Callback=function()
		local p = opts.Folder.."/"..cs..opts.Extension
		if isfile and isfile(p) then
			pcall(function() delfile(p) end)
			cfg = getC()
			Library:notification({Title="Deleted", Text=cs, Duration=3})
		end
	end})
end

return setmetatable(Library, {__index=function(_, i) return rawget(Library, i:lower()) or rawget(Library, i) end})
