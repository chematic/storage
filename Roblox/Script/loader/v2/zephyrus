-- ═════════════════════════════════════════════════════════════════════════
--  PAGE 3 : SETTINGS — teste runtime control, notifications, config
-- ═════════════════════════════════════════════════════════════════════════
local st = window:new_page({ name = "Settings" })

-- ─── SECTION GAUCHE : Window Controls ───
local wctrl = st:new_section({ name = "Window Controls", side = "left", size = 220 })

wctrl:new_textbox({
    name        = "Window Title",
    placeholder = "Type a new title...",
    default     = "Zephyrus — Test Suite",
    flag        = "window_title",
    callback    = function(s) end,
})

wctrl:new_button({
    name = "Apply Title",
    callback = function()
        local t = lib.flags["window_title"]
        if t and t ~= "" then
            window:set_title(t)
            lib.notify("Title updated!", 2, Color3.fromRGB(80, 200, 80))
        else
            lib.notify("Empty title!", 2, Color3.fromRGB(230, 80, 80))
        end
    end,
})

wctrl:new_button({
    name = "Apply Subtitle",
    callback = function()
        local s = lib.flags["window_title"]
        if s then
            window:set_subtitle("by " .. s)
            lib.notify("Subtitle updated!", 2, Color3.fromRGB(80, 200, 80))
        end
    end,
})

wctrl:new_seperator({ name = "Quick Toggles" })

-- Var pour tracker l'état de la keybind list
local kb_visible = true
wctrl:new_button({
    name = "Toggle Keybind List",
    callback = function()
        kb_visible = not kb_visible
        window:set_keybind_list_visibility(kb_visible)
        lib.notify("Keybind list: " .. (kb_visible and "shown" or "hidden"), 2)
    end,
})

wctrl:new_button({
    name    = "Hide UI (press again to close all)",
    confirm = true,
    callback = function()
        lib:Close()
    end,
})

-- ─── SECTION DROITE : Notifications ───
local notif_sec = st:new_section({ name = "Notifications", side = "right", size = 200 })

notif_sec:new_button({
    name = "Success (green)",
    callback = function()
        lib.notify("Success! Operation complete.", 3, Color3.fromRGB(80, 200, 80))
    end,
})

notif_sec:new_button({
    name = "Warning (yellow)",
    callback = function()
        lib.notify("Warning! Check your settings.", 3, Color3.fromRGB(230, 190, 90))
    end,
})

notif_sec:new_button({
    name = "Error (red)",
    callback = function()
        lib.notify("Error! Something went wrong.", 3, Color3.fromRGB(230, 80, 80))
    end,
})

notif_sec:new_button({
    name = "Info (blue)",
    callback = function()
        lib.notify("Info: loading assets...", 3, Color3.fromRGB(100, 140, 255))
    end,
})

notif_sec:new_button({
    name = "Spam x5",
    callback = function()
        task.spawn(function()
            for i = 1, 5 do
                lib.notify("Spam message #" .. i, 4)
                task.wait(0.15)
            end
        end)
    end,
})

-- ─── SECTION DROITE : Config ───
local cfg_sec = st:new_section({ name = "Config", side = "right", size = 170 })

cfg_sec:new_button({
    name = "Save Config",
    callback = function()
        local ok, err = pcall(function()
            local json = window:get_config()
            writefile("zephyrus/test_config.json", json)
        end)
        if ok then
            lib.notify("Config saved!", 3, Color3.fromRGB(80, 200, 80))
        else
            lib.notify("Save failed: " .. tostring(err), 4, Color3.fromRGB(230, 80, 80))
        end
    end,
})

cfg_sec:new_button({
    name = "Load Config",
    callback = function()
        if isfile("zephyrus/test_config.json") then
            local ok, err = pcall(function()
                lib:load_config("zephyrus/test_config.json")
            end)
            if ok then
                lib.notify("Config loaded!", 3, Color3.fromRGB(80, 200, 80))
            else
                lib.notify("Load failed: " .. tostring(err), 4, Color3.fromRGB(230, 80, 80))
            end
        else
            lib.notify("No config file found!", 3, Color3.fromRGB(230, 80, 80))
        end
    end,
})

cfg_sec:new_button({
    name = "Delete Config",
    confirm = true,
    callback = function()
        if isfile("zephyrus/test_config.json") then
            delfile("zephyrus/test_config.json")
            lib.notify("Config deleted!", 3, Color3.fromRGB(80, 200, 80))
        else
            lib.notify("Nothing to delete!", 2)
        end
    end,
})

