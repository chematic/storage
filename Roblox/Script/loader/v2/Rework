	function Window:SetVisible(v)
		if v == isVis then return end
		isVis = v
		if v then
			Library._activeWindow = Window
			win.Visible = true
			local v_ = cam.ViewportSize
			local targetScale = isCompact
				and math.clamp(math.min(math.min(520, v_.X - 40) / 720, math.min(380, v_.Y - 60) / 460), 0.5, 1)
				or math.clamp(math.min(math.min(720, v_.X - 40) / 720, math.min(460, v_.Y - 60) / 460), 0.5, 1)
			us.Scale = targetScale * 0.88
			TS:Create(us, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = targetScale }):Play()
			sn(K.soundOpen, 0.25)
		else
			closeActivePopup(); closeCtx(); hideTooltip()
			win.Visible = false
			if srchDrop then srchDrop.Visible = false end
			-- FIX #15: if last active window hides, clear so keybind check falls back gracefully
			if Library._activeWindow == Window then Library._activeWindow = nil end
		end
	end
	function Window:Toggle() self:SetVisible(not isVis) end
	function Window:OnClose(fn) self._onClose = fn end

	function Window:Destroy()
		if self._onClose then pcall(self._onClose) end
		closeActivePopup(); closeCtx(); hideTooltip()
		-- FIX #15: clear active window ref
		if Library._activeWindow == Window then Library._activeWindow = nil end
		local toRemove = {}
		for id, h in pairs(Library._registry) do
			if h and h._id and h._id:sub(1, #opts.PersistId) == opts.PersistId then table.insert(toRemove, id) end
		end
		for _, id in ipairs(toRemove) do Library._registry[id] = nil end
		if Library._bindRegistry then
			local bindKeys = {}
			for k, h in pairs(Library._bindRegistry) do
				if h and h._id and h._id:sub(1, #opts.PersistId) == opts.PersistId then table.insert(bindKeys, k) end
			end
			for _, k in ipairs(bindKeys) do Library._bindRegistry[k] = nil end
		end
		windowEls = {}
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		if gui then gui:Destroy() end
		-- FIX #10: cleanup frame handles AFTER gui destroyed (frames now have no parent)
		for k in pairs(Library._frameHandles) do
			if not k or not k.Parent then Library._frameHandles[k] = nil end
		end
		pruneThemed()
	end

