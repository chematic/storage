--  TAB
-- ═══════════════════════════════════════════════════════════════════════════
function Library:tab(opts)
	opts = self:set_defaults({Name="New Tab", Icon=">_"}, opts)
	local tab = self.container:object("ScrollingFrame", {AnchorPoint=Vector2.new(0,1), Visible=false, BackgroundTransparency=1, Position=UDim2.fromScale(0,1), Size=UDim2.fromScale(1,1), ScrollBarThickness=0, ScrollingDirection=Enum.ScrollingDirection.Y, CanvasSize=UDim2.new(), ZIndex=8})
	local qaBtn
	if not opts.Internal then
		qaBtn = self.quickAccess:object("TextButton", {Theme={BackgroundColor3="Secondary"}, ZIndex=9}):round(2)
		qaBtn:stroke({"Tertiary", -30}, 1)
		qaBtn:object("TextLabel", {BackgroundTransparency=1, Theme={TextColor3="Tertiary"}, Text=opts.Icon, Size=UDim2.fromScale(1,1), TextSize=12, Font=Enum.Font.Code, TextXAlignment=Enum.TextXAlignment.Center, ZIndex=10}):tooltip(opts.Name)
	else qaBtn = opts.Internal end

	local layout = tab:object("UIListLayout", {Padding=UDim.new(0,8), HorizontalAlignment=Enum.HorizontalAlignment.Center})
	tab:object("UIPadding", {PaddingTop=UDim.new(0,10), PaddingBottom=UDim.new(0,10)})
	local tabBtn = Library:object("TextButton", {BackgroundTransparency=0.85, Parent=self.nilFolder.AbsoluteObject, Theme={BackgroundColor3="Tertiary"}, Size=UDim2.new(0,110,0,26), Visible=false, ZIndex=8}):round(2)
	self.Tabs[#self.Tabs+1] = {tab, tabBtn, opts.Name}

	do
		local d, h = false, false
		tabBtn.MouseEnter:connect(function() h=true; tabBtn:tween{BackgroundTransparency=((selectedTab==tabBtn) and 0.1) or 0.7} end)
		tabBtn.MouseLeave:connect(function() h=false; tabBtn:tween{BackgroundTransparency=((selectedTab==tabBtn) and 0.1) or 0.85} end)
		tabBtn.MouseButton1Down:connect(function() d=true; tabBtn:tween{BackgroundTransparency=0.05} end)
		UserInputService.InputEnded:connect(function(k) if k.UserInputType==Enum.UserInputType.MouseButton1 then d=false; tabBtn:tween{BackgroundTransparency=((selectedTab==tabBtn) and 0.1) or (h and 0.7) or 0.85} end end)
		local function activateTab()
			for _, ti in next, self.Tabs do
				if ti[2] ~= tabBtn then ti[1].Visible = false end
			end
			if selectedTab ~= tabBtn then selectedTab:tween{BackgroundTransparency=0.85} end
			selectedTab = tabBtn; tab.Visible = true; tabBtn.BackgroundTransparency = 0.1
			Library.UrlLabel.Text = "> " .. Library.Url .. "/" .. opts.Name:lower()
		end
		tabBtn.MouseButton1Click:Connect(activateTab)
		qaBtn.MouseEnter:connect(function() pcall(function() qaBtn:tween{BackgroundTransparency=0.5} end) end)
		qaBtn.MouseLeave:connect(function() pcall(function() qaBtn:tween{BackgroundTransparency=0} end) end)
		qaBtn.MouseButton1Click:connect(function()
			if not tabBtn.Visible then
				tabBtn.Parent = self.navigation.AbsoluteObject
				tabBtn.Size = UDim2.new(0, 30, 0, 26)
				tabBtn.Visible = true; tabBtn:fade(false, Library.CurrentTheme.Main, 0.08)
				tabBtn:tween({Size=UDim2.new(0,110,0,26), Length=0.1})
			end
			activateTab()
		end)
	end

	tabBtn:object("Frame", {AnchorPoint=Vector2.new(0,0.5), Position=UDim2.new(0,2,0.5,0), Size=UDim2.fromOffset(2,14), Theme={BackgroundColor3="Tertiary"}, ZIndex=12}):round(1)
	tabBtn:object("TextLabel", {Theme={TextColor3="StrongText"}, AnchorPoint=Vector2.new(0,.5), BackgroundTransparency=1, TextSize=12, Text=opts.Name, Position=UDim2.new(0,10,0.5,0), TextXAlignment=Enum.TextXAlignment.Left, Size=UDim2.new(1,-28,0.5,0), Font=Enum.Font.Code, TextTruncate=Enum.TextTruncate.AtEnd, ZIndex=9})
	local tabBtnClose = tabBtn:object("TextButton", {AnchorPoint=Vector2.new(1,0.5), BackgroundTransparency=1, Position=UDim2.new(1,-6,0.5,0), Size=UDim2.fromOffset(14,14), Text="x", TextSize=10, Font=Enum.Font.Code, Theme={TextColor3="StrongText"}, ZIndex=9})

	tabBtnClose.MouseButton1Click:connect(function()
		tabBtn:fade(true, Library.CurrentTheme.Main, 0.08)
		tabBtn:tween({Size=UDim2.new(0,30,0,26), Length=0.08}, function() tabBtn.Visible=false; tab.Visible=false; tabBtn.Parent=self.nilFolder.AbsoluteObject end)
		local v = {}
		for _, t in next, self.Tabs do
			if t[2].Visible and t[2] ~= tabBtn then v[#v+1] = t end
		end
		if selectedTab == self.homeButton or #v == 0 then
			tab.Visible = false; self.homePage.Visible = true
			self.homeButton:tween{BackgroundTransparency=0.1}; selectedTab = self.homeButton
			Library.UrlLabel.Text = "> " .. Library.Url .. "/home"
		else
			local last = v[#v]
			for _, t in next, self.Tabs do
				if t[2] ~= last[2] then t[1].Visible = false end
			end
			last[2]:tween{BackgroundTransparency=0.1}; last[1].Visible = true
			selectedTab = last[2]; Library.UrlLabel.Text = "> " .. Library.Url .. "/" .. last[3]:lower()
		end
	end)

	return setmetatable({statusText=self.statusText, container=tab, Theme=self.Theme, core=self.core, gui=self.gui, layout=layout}, Library)
end

function Library:_resize_tab()
	if self.container.ClassName == "ScrollingFrame" then
		self.container.CanvasSize = UDim2.fromOffset(0, self.layout.AbsoluteContentSize.Y + 24)
	else
		self.sectionContainer.Size = UDim2.new(1,-24,0, self.layout.AbsoluteContentSize.Y + 20)
		self.parentContainer.CanvasSize = UDim2.fromOffset(0, self.parentLayout.AbsoluteContentSize.Y + 20)
	end
end

