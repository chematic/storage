						NumberSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
						NumberSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
						NumberSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
