function Library:notification(opts)
	opts = self:set_defaults({Title="Notification", Text="Message", Duration=3, Callback=function() end}, opts)
	local faded = false; local fadeOut
	local noti = self.notifs:object("Frame", {BackgroundTransparency=1, Theme={BackgroundColor3="Main"}, Size=UDim2.new(0,300,0,0), ZIndex=100}):round(3)
	noti:stroke({"Tertiary", -30}, 1)
	noti:object("UIPadding", {PaddingBottom=UDim.new(0,10), PaddingTop=UDim.new(0,10), PaddingLeft=UDim.new(0,10), PaddingRight=UDim.new(0,10)})
	local durHolder = noti:object("Frame", {BackgroundTransparency=1, Theme={BackgroundColor3="Secondary"}, AnchorPoint=Vector2.new(0,1), Position=UDim2.fromScale(0,1), Size=UDim2.new(1,0,0,2), ZIndex=101}):round(100)
	local len = durHolder:object("Frame", {BackgroundTransparency=1, Theme={BackgroundColor3="Tertiary"}, Size=UDim2.fromScale(1,1), ZIndex=102}):round(100)
	local text = noti:object("TextLabel", {BackgroundTransparency=1, Text=opts.Text, Position=UDim2.new(0,0,0,20), Size=UDim2.new(1,0,100,0), TextSize=12, Font=Enum.Font.Code, TextTransparency=1, TextWrapped=true, Theme={TextColor3="WeakText"}, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top, ZIndex=102})
	text:tween({Size=UDim2.new(1,0,0,text.TextBounds.Y)})
	local title = noti:object("TextLabel", {BackgroundTransparency=1, Position=UDim2.fromOffset(0,0), Size=UDim2.new(1,-20,0,16), Text="> [OK] " .. opts.Title, TextSize=12, Font=Enum.Font.Code, Theme={TextColor3="Tertiary"}, TextXAlignment=Enum.TextXAlignment.Left, TextWrapped=true, TextTruncate=Enum.TextTruncate.AtEnd, TextTransparency=1, ZIndex=102})
	local exit = noti:object("TextButton", {BackgroundTransparency=1, Position=UDim2.new(1,-18,0,0), Size=UDim2.fromOffset(16,16), Text="x", TextSize=11, Font=Enum.Font.Code, Theme={TextColor3="WeakText"}, TextTransparency=1, ZIndex=102})

	fadeOut = function()
		if faded then return end; faded = true
		task.delay(0.25, function() pcall(function() noti.AbsoluteObject:Destroy() end); opts.Callback() end)
		durHolder:tween({BackgroundTransparency=1, Length=0.15}); len:tween({BackgroundTransparency=1, Length=0.15})
		text:tween({TextTransparency=1, Length=0.15})
		title:tween({TextTransparency=1, Length=0.15})
		exit:tween({TextTransparency=1, Length=0.15})
		noti:tween({BackgroundTransparency=1, Length=0.15, Size=UDim2.fromOffset(300,0)})
	end
	exit.MouseButton1Click:Connect(fadeOut)
	noti:tween({BackgroundTransparency=0, Length=0.15, Size=UDim2.fromOffset(300, text.TextBounds.Y + 54)}, function()
		durHolder:tween({BackgroundTransparency=0, Length=0.15}); len:tween({BackgroundTransparency=0, Length=0.15})
		text:tween({TextTransparency=0, Length=0.15}); title:tween({TextTransparency=0, Length=0.15}); exit:tween({TextTransparency=0, Length=0.15})
	end)
	len:tween({Size=UDim2.fromScale(0,1), Length=opts.Duration}, fadeOut)
end

