-- (Hyperion/Byfron). Maintenant : early-return si alpha=nil (cas du test),
-- et pcall silencieux si on tente le metatable hack.
function utility.rgba(r, g, b, a)
    local rgb = Color3.fromRGB(r, g, b)
    if a == nil or a == 255 then
        return rgb
    end
    pcall(function()
        local mt = table.clone(getrawmetatable(rgb))
        setreadonly(mt, false)
        local old = mt.__index
        mt.__index = newcclosure(function(self, key)
            if key:lower() == "a" then return a end
            return old(self, key)
        end)
        setrawmetatable(rgb, mt)
    end)
    return rgb
end

function utility.table(tbl, usemt)
    tbl = tbl or {}; local old = table.clone(tbl); table.clear(tbl)
    for k, v in next, old do if type(k) == "string" then tbl[k:lower()] = v else tbl[k] = v end end
    if usemt then
        setmetatable(tbl, {
            __index    = function(t, k) return rawget(t, k:lower()) or rawget(t, k) end,
            __newindex = function(t, k, v) if type(k) == "string" then rawset(t, k:lower(), v) else rawset(t, k, v) end end
        })
    end
    return tbl
end
function utility.dragify(main, outline, target)
    local start, origin, dragging
    main.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; start = i.Position; origin = target.Position; outline.Visible = true
