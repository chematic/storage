-- =========================================================================
--  ZEPHYRUS UI — SCRIPT DE TEST COMPLET
--  Teste TOUTES les fonctionnalités de la librairie :
--    • new_window + set_title / set_subtitle runtime
--    • new_page (multi-pages)
--    • new_section (simple)
--    • new_section_holder → new_section (multi-onglets internes)
--    • new_toggle (+ new_colorpicker enfant)
--    • new_slider (int + float)
--    • new_button (+ confirm)
--    • new_dropdown (simple, multi-select, list)
--    • new_keybind (Hold + Toggle)
--    • new_seperator
--    • new_colorpicker
--    • new_textbox
--    • notifications (normales + colorées + spam)
--    • keybind list visibility
--    • save / load config via get_config() et load_config()
-- =========================================================================

-- ─────────────────────────────────────────────────────────────────────────
--  ÉTAPE 1 : Charger la librairie
-- ─────────────────────────────────────────────────────────────────────────
-- Option A : si tu héberges la lib en ligne
-- local lib = loadstring(game:HttpGet("https://TON_URL_ICI/library.lua"))()

-- Option B : si tu as la lib dans un fichier local
-- local lib = loadstring(readfile("zephyrus_lib.lua"))()

-- Option C : si tu as collé la lib direct dans le même script au-dessus
-- (dans ce cas, remplace juste `library` par le nom que tu lui as donné)
local lib = library -- ← adapte ici si besoin

-- ─────────────────────────────────────────────────────────────────────────
--  ÉTAPE 2 : Créer la fenêtre avec titre + sous-titre custom
-- ─────────────────────────────────────────────────────────────────────────
local window = lib:new_window({
    title    = "Zephyrus — Test Suite",
    subtitle = "v1.0 · all features",
    size     = Vector2.new(680, 460),
})

-- Affiche la keybind list (panneau à gauche)
window:set_keybind_list_visibility(true)

-- ═════════════════════════════════════════════════════════════════════════
--  PAGE 1 : COMBAT — teste tous les composants simples
-- ═════════════════════════════════════════════════════════════════════════
local combat = window:new_page({ name = "Combat" })

-- ─── SECTION GAUCHE ───
local aim = combat:new_section({ name = "Aimbot", side = "left", size = 290 })

-- Toggle simple
aim:new_toggle({
    name  = "Enable Aimbot",
    state = false,
    flag  = "aimbot_enabled",
    callback = function(v)
        lib.notify("Aimbot: " .. (v and "ON" or "OFF"), 2)
    end,
})

-- Toggle "risky" (texte jaune)
aim:new_toggle({
    name  = "Risky Mode",
    risky = true,
    callback = function(v)
        lib.notify("Risky: " .. tostring(v), 2, Color3.fromRGB(230, 190, 90))
    end,
})

-- Toggle avec colorpicker enfant (couleur ESP dans le toggle)
local esp_tgl = aim:new_toggle({
    name = "ESP Highlight",
    callback = function(v) end,
})
esp_tgl:new_colorpicker({
    name    = "ESP Color",
    default = Color3.fromRGB(255, 80, 80),
    callback = function(c)
        -- c est un Color3
    end,
})

-- Slider entier
local fov_slider = aim:new_slider({
    name    = "FOV",
    min     = 0,
    max     = 360,
    default = 90,
    float   = 1,
    flag    = "aimbot_fov",
    text    = "[value]°",
    callback = function(v) end,
})

-- Slider décimal
aim:new_slider({
    name    = "Smoothing",
    min     = 0,
    max     = 100,
    default = 25.5,
    float   = 0.1,
    callback = function(v) end,
})

-- Dropdown simple
aim:new_dropdown({
    name     = "Hitbox",
    options  = { "Head", "Body", "Closest", "Random" },
    default  = "Head",
    flag     = "hitbox",
    callback = function(v)
        lib.notify("Hitbox: " .. tostring(v), 2)
    end,
})

-- Dropdown multi-sélection (max 2)
aim:new_dropdown({
    name    = "Multi Hit",
    options = { "Head", "Body", "Arms", "Legs" },
    max     = 2,
    default = { "Head" },
    callback = function(t)
        lib.notify("Multi: " .. #t .. " sélectionné(s)", 2)
    end,
})

-- Colorpicker
aim:new_colorpicker({
    name    = "Box Color",
    default = Color3.fromRGB(255, 0, 0),
    flag    = "box_color",
    callback = function(c) end,
})

-- Bouton avec confirmation (3s)
aim:new_button({
    name    = "Reset Aimbot Settings",
    confirm = true,
    callback = function()
        fov_slider:set(90)
        lib.notify("Settings reset!", 3, Color3.fromRGB(80, 200, 80))
    end,
})

-- ─── SECTION DROITE ───
local misc = combat:new_section({ name = "Keybinds & Misc", side = "right", size = 290 })

-- Keybind mode "Hold"
misc:new_keybind({
    name    = "Aimbot Key (Hold)",
    default = Enum.KeyCode.V,
    mode    = "Hold",
    callback = function(active)
        if active then
            lib.notify("Aimbot key held", 1)
        end
    end,
})

-- Keybind mode "Toggle"
misc:new_keybind({
    name    = "Speed Key (Toggle)",
    default = Enum.KeyCode.Q,
    mode    = "Toggle",
    callback = function(active)
        lib.notify("Speed: " .. (active and "ON" or "OFF"), 2)
    end,
})

-- Keybind sans clé par défaut
misc:new_keybind({
    name = "Optional Key",
    mode = "Hold",
    callback = function(active) end,
})

-- Séparateur
misc:new_seperator({ name = "Text & Buttons" })

-- Textbox
local name_box = misc:new_textbox({
    name        = "Player Name",
    placeholder = "Enter your name...",
    default     = "",
    flag        = "player_name",
    callback = function(s) end,
})

-- Textbox centré
misc:new_textbox({
    name        = "Centered Box",
    placeholder = "Type here...",
    middle      = true,
    callback    = function(s) end,
})

-- Bouton simple (sans confirm)
misc:new_button({
    name = "Show Notification",
    callback = function()
        lib.notify("Hello from Zephyrus! 🎉", 4)
    end,
})

misc:new_button({
    name = "Show Player Name",
    callback = function()
        local n = lib.flags["player_name"]
        lib.notify("Name is: '" .. (n or "") .. "'", 3, Color3.fromRGB(100, 140, 255))
    end,
})

-- ═════════════════════════════════════════════════════════════════════════
--  PAGE 2 : VISUALS — teste section_holder (multi-onglets) et list dropdown
-- ═════════════════════════════════════════════════════════════════════════
