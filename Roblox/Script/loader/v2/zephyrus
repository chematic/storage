	opts = self:set_defaults({Name="Keybind", Keybind=nil, Description=nil, Callback=function() end}, opts)
	local c, h = self:_widget_base(opts.Name, opts.Description)
	local kd = c:object("TextLabel", {AnchorPoint=Vector2.new(1,0.5), Theme={BackgroundColor3={"Secondary",-20},TextColor3="Tertiary"}, Position=UDim2.new(1,-12,0.5,0), Size=UDim2.fromOffset(80,18), TextSize=11, Font=Enum.Font.Code, Text=(opts.Keybind and tostring(opts.Keybind.Name):upper()) or "[ -- ]", TextXAlignment=Enum.TextXAlignment.Center, ZIndex=10}):round(2):stroke({"Tertiary", -40}, 1)
	local h_, d_, listen = false, false, false
	c.MouseEnter:connect(function() h_=true; c:tween{BackgroundColor3=self:lighten(Library.CurrentTheme.Secondary,10)} end)
	c.MouseLeave:connect(function() h_=false; if not d_ and not listen then c:tween{BackgroundColor3=Library.CurrentTheme.Secondary} end end)
	c.MouseButton1Down:connect(function() d_=true; c:tween{BackgroundColor3=self:lighten(Library.CurrentTheme.Secondary,18)} end)
	UserInputService.InputEnded:connect(function(k) if k.UserInputType==Enum.UserInputType.MouseButton1 then d_=false; if not listen then c:tween{BackgroundColor3=(h_ and self:lighten(Library.CurrentTheme.Secondary,10)) or Library.CurrentTheme.Secondary} end end end)
	UserInputService.InputBegan:Connect(function(k, gpe)
		if listen and not UserInputService:GetFocusedTextBox() then
			if k.UserInputType == Enum.UserInputType.Keyboard then
				if k.KeyCode ~= Enum.KeyCode.Escape then opts.Keybind = k.KeyCode end
				kd.Text = (opts.Keybind and tostring(opts.Keybind.Name):upper()) or "[ -- ]"
				listen = false
				c:tween{BackgroundColor3=(h_ and self:lighten(Library.CurrentTheme.Secondary,10)) or Library.CurrentTheme.Secondary}
				kd:tween{BackgroundColor3=self:lighten(Library.CurrentTheme.Secondary, -20)}
			end
		elseif opts.Keybind and k.KeyCode == opts.Keybind and not gpe then
			pcall(opts.Callback)
		end
	end)
	c.MouseButton1Click:connect(function()
		if not listen then
			listen = true; kd.Text = "[ ... ]"
			kd:tween{BackgroundColor3=Library.CurrentTheme.Tertiary}
		end
	end)
	self:_resize_tab()
	local api = {}
	function api:Set(k) opts.Keybind = k; kd.Text = (opts.Keybind and tostring(opts.Keybind.Name):upper()) or "[ -- ]" end
	return api
end

function Library:slider(opts)
	opts = self:set_defaults({Name="Slider", Default=50, Min=0, Max=100, Description=nil, Callback=function() end}, opts)
	local c, h = self:_widget_base(opts.Name, opts.Description)
	local valText = c:object("TextLabel", {AnchorPoint=Vector2.new(1,0.5), Theme={BackgroundColor3={"Secondary",-20},TextColor3="Tertiary"}, Position=UDim2.new(1,-12,0.5,0), Size=UDim2.fromOffset(50,18), TextSize=11, Font=Enum.Font.Code, Text=tostring(opts.Default), TextXAlignment=Enum.TextXAlignment.Center, ZIndex=10}):round(2):stroke({"Tertiary", -40}, 1)
	local track = c:object("Frame", {AnchorPoint=Vector2.new(0,1), Theme={BackgroundColor3={"Tertiary", -50}}, Position=UDim2.new(0,12,1,-8), Size=UDim2.new(1,-24,0,3), ZIndex=10}):round(100)
	local fill = track:object("Frame", {Size=UDim2.fromScale(((opts.Default-opts.Min)/(opts.Max-opts.Min)), 1), Theme={BackgroundColor3="Tertiary"}, ZIndex=11}):round(100)
	local thumb = fill:object("Frame", {AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.fromScale(1,0.5), Size=UDim2.fromOffset(10,10), Theme={BackgroundColor3="Tertiary"}, ZIndex=12}):round(1)
	thumb:stroke({"Tertiary", 10}, 1)

	local dragging = false
	c.MouseButton1Down:connect(function()
		dragging = true
		while dragging and c.AbsoluteObject.Parent do
			local pct = math.clamp((Mouse.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			local v = math.floor((opts.Max - opts.Min) * pct + opts.Min + 0.5)
			valText.Text = tostring(v)
			fill.Size = UDim2.fromScale(pct, 1)
			pcall(opts.Callback, v)
			RunService.RenderStepped:Wait()
		end
	end)
	UserInputService.InputEnded:connect(function(k) if k.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
	self:_hover_style(c, Library.CurrentTheme.Secondary, self:lighten(Library.CurrentTheme.Secondary, 10), self:lighten(Library.CurrentTheme.Secondary, 10))
	self:_resize_tab()
	local api = {}
	function api:Set(v)
		v = math.clamp(v, opts.Min, opts.Max)
		local pct = (v - opts.Min) / (opts.Max - opts.Min)
		fill.Size = UDim2.fromScale(pct, 1)
		valText.Text = tostring(math.floor(v))
	end
	return api
end

