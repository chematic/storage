			hit.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					if h._disabled then return end
					dr = true; cachedAbsX = tr.AbsolutePosition.X; cachedAbsW = tr.AbsoluteSize.X; pendingPos = i.Position.X
					tw(kn, 0.15, { Size = UDim2.new(0, 18, 0, 18) })
					ap(fx(pendingPos), true)
				end
			end)
			Connect(UIS.InputChanged, function(i)
				if dr and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then pendingPos = i.Position.X end
			end)
			Connect(RS.RenderStepped, function() if dr and pendingPos then ap(fx(pendingPos), true) end end)
			Connect(UIS.InputEnded, function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					if dr then dr = false; pendingPos = nil; tw(kn, 0.15, { Size = UDim2.new(0, 14, 0, 14) }) end
				end
			end)
			vl.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
					if h._disabled then return end
					local tb = mk("TextBox", { Size = UDim2.new(0, 80, 0, 18), Position = UDim2.new(1, -98, 0, 8), BackgroundColor3 = K.sb, Text = string.format("%g", h.v), TextColor3 = K.tx, Font = K.fontBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, ClearTextOnFocus = true, Parent = f })
					rc(tb, 4); sk(tb, K.ac, 1)
					vl.Visible = false
					tb:CaptureFocus()
					local function finish()
						local num = tonumber(tb.Text)
						if num then ap((math.clamp(num, mn, mx) - mn) / (mx - mn), false) end
						tb:Destroy(); vl.Visible = true
					end
					tb.FocusLost:Connect(finish)
				end
			end)
			ap((v - mn) / (mx - mn), false, true)
			function h:set(x) ap((x - mn) / (mx - mn), false); return self end
